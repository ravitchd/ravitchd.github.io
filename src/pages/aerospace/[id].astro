---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PrintStage from '../../components/PrintStage.astro';

export async function getStaticPaths() {
  const items = await getCollection('aerospace');
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
---

<Base title={d.title} description={d.summary}>
  <article class="section">
    <div class="container">
      <a href="/aerospace/">← All aerospace</a>
      <div class="head">
        <div>
          <span class="kicker">{d.category}</span>
          <h1 style={`view-transition-name: ae-${item.id}`}>{d.title}</h1>
          <p class="muted">{d.summary}</p>
        </div>
        {
          (d.links.length > 0 || d.files.length > 0) && (
            <div class="files">
              {d.links.map((l, i) => (
                <a class:list={['btn', { primary: i === 0 }]} href={l.href}>
                  {l.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
              {d.files.map((f, i) => (
                <a class:list={['btn', { primary: i === 0 && d.links.length === 0 }]} href={f.href} download>
                  <span aria-hidden="true">↓</span> {f.label}
                </a>
              ))}
            </div>
          )
        }
      </div>

      {
        (d.model || d.image) && (
          <div data-reveal>
            {d.model ? (
              <PrintStage model={d.model} title={d.title} controls />
            ) : (
              <div class="shot">
                <Picture src={d.image!} alt={d.alt ?? d.title} widths={[640, 1200]} sizes="(max-width: 1040px) 100vw, 992px" formats={['avif', 'webp']} />
              </div>
            )}
          </div>
        )
      }

      <div class="cols">
        <div class="prose">
          <Content />
          {d.project && <p><a href={`/projects/${d.project.id}/`}>Read the full project write-up →</a></p>}
        </div>
        {
          d.tools.length > 0 && (
            <aside data-reveal>
              <h2>Tools</h2>
              <ul>
                {d.tools.map((t) => <li>{t}</li>)}
              </ul>
            </aside>
          )
        }
      </div>
    </div>
  </article>
</Base>

<script>
  import { initPrints } from '../../scripts/prints/main';
  initPrints();
</script>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 32px;
    flex-wrap: wrap;
    margin: 1.2rem 0 24px;
  }
  .head h1 { margin: 0.4rem 0 0.3rem; }
  .head p { margin: 0; max-width: 560px; }
  .kicker {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .files { display: flex; gap: 10px; flex-wrap: wrap; }
  .shot {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .shot :global(img) { display: block; width: 100%; max-height: 72vh; object-fit: contain; }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 40px;
    margin-top: 40px;
    align-items: start;
  }
  aside {
    position: sticky;
    top: 88px;
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  aside h2 { font-size: 1.15rem; margin: 0; }
  aside ul { display: flex; flex-wrap: wrap; gap: 6px; margin: 1rem 0 0; padding: 0; list-style: none; }
  aside li {
    padding: 0.25rem 0.7rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    font-size: 0.85rem;
    font-weight: 600;
  }
  @media (max-width: 820px) {
    .cols { grid-template-columns: 1fr; gap: 24px; }
    aside { position: static; order: -1; }
  }
</style>
