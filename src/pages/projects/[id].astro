---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tech, repo, demo } = project.data;
const print = (await getCollection('prints')).find((p) => p.data.project?.id === project.id);
---

<Base title={title} description={summary}>
  <article class="section">
    <div class="container prose">
      <a href="/projects/">← All projects</a>
      <h1 style={`margin-top: 1rem; view-transition-name: p-${project.id}`}>{title}</h1>
      <p class="muted">{summary}</p>
      <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:1rem">{tech.map((t) => <span class="tag">{t}</span>)}</div>
      <div style="display:flex;gap:12px;margin-bottom:2rem">
        {repo && <a class="btn" href={repo}>Code</a>}
        {demo && <a class="btn primary" href={demo}>Live demo</a>}
        {print && <a class="btn" href={`/prints/${print.id}/`}>View the 3D model</a>}
      </div>
      <Content />
    </div>
  </article>
</Base>
