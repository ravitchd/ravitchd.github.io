---
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';

// Each dish is a Markdown file in src/content/gallery (see _template.md there).
const entries = (await getCollection('gallery')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const pad = (n: number) => String(n).padStart(2, '0');
const dishes = await Promise.all(
  entries.map(async (e, i) => {
    const { image } = e.data;
    const size = (w: number) => Math.min(w, image.width);
    const [tex, texSm, large] = await Promise.all([
      getImage({ src: image, width: size(800), format: 'webp', quality: 80 }),
      getImage({ src: image, width: size(560), format: 'webp', quality: 78 }),
      getImage({ src: image, width: size(1600), format: 'webp', quality: 82 }),
    ]);
    return {
      ...e.data,
      id: e.id,
      no: pad(i + 1),
      tex: tex.src,
      texSm: texSm.src,
      large: large.src,
      recipeHref: e.data.recipe && `/recipes/${e.data.recipe.id}/`,
    };
  }),
);
const pizzaNights = dishes.filter((d) => d.tags.includes('pizza')).length;

// What the page script needs, with < escaped so nothing can close the script tag early.
const data = JSON.stringify(
  dishes.map((d) => ({
    id: d.id,
    no: d.no,
    title: d.title,
    caption: d.caption,
    tags: d.tags,
    alt: d.alt,
    w: d.image.width,
    h: d.image.height,
    tex: d.tex,
    texSm: d.texSm,
    large: d.large,
    recipe: d.recipeHref || undefined,
  })),
).replace(/</g, '\\u003c');
---

<Base title="Gallery" description="Dishes Dylan has cooked at home: Neapolitan pizza, crunchwraps, crispy chicken and more.">
  <script is:inline>
    // Decide before first paint whether to show the 3D wall or the plain grid.
    (function () {
      var d = document.documentElement;
      if (!window.WebGL2RenderingContext) return;
      d.classList.add('g-can');
      var opted = false;
      try { opted = sessionStorage.getItem('g-motion') === '1'; } catch (e) {}
      if (matchMedia('(prefers-reduced-motion: reduce)').matches && !opted) return;
      d.classList.add('g-webgl');
      try { if (localStorage.getItem('g-mode') === 'ring') d.classList.add('g-ring'); } catch (e) {}
    })();
  </script>

  <header class="g-head container">
    <p class="eyebrow">Gallery</p>
    <h1 class="g-title">Cooked <em>at home.</em></h1>
    <dl class="g-stats">
      <div><dt>Dishes</dt><dd data-count={dishes.length}>{dishes.length}</dd></div>
      <div><dt>Pizza nights</dt><dd data-count={pizzaNights}>{pizzaNights}</dd></div>
      <div><dt>Heart-shaped</dt><dd data-count="1">1</dd></div>
    </dl>
  </header>

  <div class="g-stage" tabindex="0" role="region" aria-label="Photo wall" aria-describedby="g-desc">
    <div class="g-back" aria-hidden="true"><div class="g-back-track"><span></span><span></span></div></div>
    <canvas class="g-canvas" aria-hidden="true"></canvas>
    <div class="g-fade" aria-hidden="true"></div>
  </div>
  <p id="g-desc" class="g-sr">
    Drag, scroll or use the arrow keys to look around, and press Enter to open the dish in the middle. The Index button
    lists every dish.
  </p>
  <p id="g-live" class="g-sr" aria-live="polite"></p>

  <div class="g-focus" aria-hidden="true">
    <p class="g-focus-meta"><span class="g-focus-no"></span><span class="g-focus-tags"></span></p>
    <p class="g-focus-title"></p>
  </div>

  <div class="g-loader" aria-hidden="true">
    <span class="g-loader-num">000</span>
    <span class="g-loader-bar"></span>
  </div>

  <p class="g-hint" aria-hidden="true">
    <span class="g-hint-fine">Drag or scroll to explore</span>
    <span class="g-hint-touch"><span class="g-hint-hand"></span>Drag to explore</span>
  </p>

  <div class="g-controls">
    <div class="g-seg" role="group" aria-label="Layout">
      <span class="g-seg-thumb" aria-hidden="true"></span>
      <button type="button" data-mode="wall" aria-pressed="true">
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
          <rect x="1.5" y="1.5" width="5.2" height="6.4" rx="1.3"></rect>
          <rect x="9.3" y="1.5" width="5.2" height="4.2" rx="1.3"></rect>
          <rect x="1.5" y="10.1" width="5.2" height="4.4" rx="1.3"></rect>
          <rect x="9.3" y="7.9" width="5.2" height="6.6" rx="1.3"></rect>
        </svg>
        Wall
      </button>
      <button type="button" data-mode="ring" aria-pressed="false">
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
          <ellipse cx="8" cy="8.6" rx="6.6" ry="3.4" fill="none" stroke="currentColor" stroke-width="1.4"></ellipse>
          <rect x="6" y="5.4" width="4" height="5.4" rx="1"></rect>
        </svg>
        Ring
      </button>
    </div>
    <button type="button" class="g-index-btn" aria-expanded="false" aria-controls="g-index">
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
        <rect x="1.5" y="3" width="13" height="1.5" rx=".75"></rect>
        <rect x="1.5" y="7.25" width="13" height="1.5" rx=".75"></rect>
        <rect x="1.5" y="11.5" width="9" height="1.5" rx=".75"></rect>
      </svg>
      Index
    </button>
  </div>

  <aside class="g-index" id="g-index" aria-label="All dishes" tabindex="-1" hidden>
    <p class="g-index-head"><span>Index</span><span>{pad(dishes.length)}</span></p>
    <ol>
      {
        dishes.map((d, i) => (
          <li>
            <button type="button" data-i={i}>
              <img src={d.texSm} alt="" width="40" height="52" loading="lazy" decoding="async" />
              <span class="g-ix-no">{d.no}</span>
              <span class="g-ix-title">{d.title}</span>
              <span class="g-ix-tag">{d.tags[0]}</span>
            </button>
          </li>
        ))
      }
    </ol>
  </aside>

  <div class="g-cursor" aria-hidden="true"><span class="g-cursor-label">Drag</span></div>

  <section class="g-fallback container" aria-label="Dishes">
    <p class="g-optin-wrap">
      <button type="button" class="btn g-optin">Turn on the interactive gallery</button>
    </p>
    <ul class="g-grid">
      {
        dishes.map((d, i) => (
          <li>
            <a class="g-card" href={d.large} data-i={i}>
              <span class="g-card-img">
                <Picture
                  src={d.image}
                  widths={[420, 700, 1000]}
                  sizes="(max-width: 700px) 100vw, (max-width: 1040px) 50vw, 340px"
                  formats={['avif', 'webp']}
                  alt={d.alt}
                  loading="lazy"
                />
              </span>
              <span class="g-card-text">
                <span class="g-card-no">Nº {d.no}</span>
                <span class="g-card-title">{d.title}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <dialog class="lb" aria-label="Dish photo">
    <div class="lb-shade"></div>
    <div class="lb-inner">
      <figure class="lb-fig">
        <div class="lb-frame"><img class="lb-img" alt="" decoding="async" /></div>
        <figcaption class="lb-text">
          <p class="lb-count"></p>
          <h2 class="lb-title"></h2>
          <p class="lb-caption"></p>
          <p class="lb-tags"></p>
          <a class="btn primary lb-recipe" hidden>Read the recipe →</a>
        </figcaption>
      </figure>
      <button class="lb-btn lb-close" type="button" aria-label="Close" autofocus>✕</button>
      <button class="lb-btn lb-prev" type="button" aria-label="Previous dish">←</button>
      <button class="lb-btn lb-next" type="button" aria-label="Next dish">→</button>
    </div>
  </dialog>

  <script type="application/json" id="g-data" set:html={data} />
</Base>

<script>
  import { initGallery } from '../scripts/gallery/main';
  initGallery();
</script>

<style is:global>
  /* Gallery page only. Classes are prefixed g- (gallery) and lb- (viewer). */
  :root { --g-edge: max(24px, calc((100vw - var(--max)) / 2 + 24px)); }

  .g-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Title and stats ---------- */
  .g-head { padding-top: 64px; padding-bottom: 40px; }
  .g-title {
    font-size: clamp(3rem, 9vw, 6.4rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .g-title em { color: var(--accent); font-weight: 500; }
  .g-stats { display: flex; gap: 14px 36px; margin: 32px 0 0; flex-wrap: wrap; }
  .g-stats div { display: flex; flex-direction: column-reverse; }
  .g-stats dt { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .g-stats dd {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3.6vw, 2.6rem);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Plain grid: no WebGL, reduced motion, or no JavaScript ---------- */
  .g-grid {
    list-style: none;
    margin: 0;
    padding: 0 0 24px;
    columns: 3 280px;
    column-gap: 24px;
  }
  .g-grid li { break-inside: avoid; margin-bottom: 28px; }
  .g-card { display: block; color: inherit; text-decoration: none; }
  .g-card-img { display: block; border-radius: 10px; overflow: hidden; background: var(--border); }
  .g-card img { display: block; width: 100%; height: auto; transition: transform 0.8s cubic-bezier(.2,.8,.2,1); }
  .g-card:hover img { transform: scale(1.03); }
  .g-card.is-out .g-card-img { visibility: hidden; }
  .g-card-text { display: flex; gap: 12px; align-items: baseline; padding-top: 10px; }
  .g-card-no { font-family: var(--serif); font-style: italic; color: var(--accent); font-size: 0.95rem; white-space: nowrap; }
  .g-card-title { font-family: var(--serif); font-size: 1.15rem; line-height: 1.3; }
  .g-optin-wrap { display: none; margin: 0 0 28px; }
  html.g-can .g-optin-wrap { display: block; }

  /* ---------- Interactive version ---------- */
  .g-stage, .g-focus, .g-loader, .g-hint, .g-controls, .g-index, .g-cursor { display: none; }

  html.g-webgl, html.g-webgl body { height: 100%; overflow: hidden; overscroll-behavior: none; }
  html.g-webgl body > footer, html.g-webgl .progress, html.g-webgl .cursor-ring { display: none !important; }
  html.g-webgl .g-fallback { display: none; }

  html.g-webgl .g-stage {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 0;
    outline: none;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  html.g-kbd .g-stage:focus-visible::after {
    content: '';
    position: absolute;
    inset: 10px;
    z-index: 3;
    border: 2px solid var(--accent);
    border-radius: 18px;
    pointer-events: none;
  }
  .g-canvas { position: absolute; inset: 0; z-index: 1; display: block; width: 100%; height: 100%; }

  /* A glow in the colour of the dish at the front of the ring */
  @property --g-glow { syntax: '<color>'; inherits: true; initial-value: transparent; }
  html.g-webgl .g-stage { transition: --g-glow 1.4s ease; }
  .g-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(50% 44% at 50% 56%, color-mix(in srgb, var(--g-glow) 30%, transparent), transparent);
    opacity: 0;
    transition: opacity 1s ease;
  }
  html.g-ring.g-ready .g-stage::before { opacity: 1; }
  @media (prefers-color-scheme: dark) {
    .g-stage::before {
      background: radial-gradient(50% 44% at 50% 56%, color-mix(in srgb, var(--g-glow) 40%, transparent), transparent);
    }
  }
  html.g-fine .g-canvas { cursor: none; }
  .g-fade {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(to bottom, var(--bg) 0, color-mix(in srgb, var(--bg) 84%, transparent) 76px, transparent 230px),
      linear-gradient(to top, color-mix(in srgb, var(--bg) 92%, transparent) 0, transparent 190px),
      radial-gradient(125% 95% at 50% 50%, transparent 58%, color-mix(in srgb, var(--bg) 55%, transparent) 100%);
  }

  /* Huge outlined title behind the ring */
  .g-back {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    z-index: 0;
    overflow: hidden;
    transform: translateY(-62%);
    opacity: 0;
    transition: opacity 0.9s ease;
    pointer-events: none;
  }
  html.g-ring.g-ready .g-back { opacity: 1; }
  .g-back-track { display: flex; width: max-content; transition: opacity 0.32s ease; }
  .g-back.swap .g-back-track { opacity: 0; }
  .g-back span {
    padding-right: 0.3em;
    font-family: var(--serif);
    font-size: clamp(5rem, 26vh, 16rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--text) 20%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .g-back-track { animation: g-marquee 70s linear infinite; }
  }
  @keyframes g-marquee { to { transform: translateX(-50%); } }

  html.g-webgl .g-head {
    position: fixed;
    top: 78px;
    left: 0;
    right: 0;
    z-index: 5;
    padding-top: 0;
    padding-bottom: 0;
    pointer-events: none;
  }
  html.g-webgl .g-head { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px 52px; }
  html.g-webgl .g-head .eyebrow { display: none; }
  html.g-webgl .g-title { font-size: clamp(2.2rem, 4.3vw, 3.8rem); }
  html.g-webgl .g-stats { margin: 0 0 4px; gap: 10px 30px; }
  html.g-webgl .g-stats dd { font-size: clamp(1.45rem, 2.3vw, 1.95rem); }
  /* A soft wash of the page colour behind the text, so it reads over any photo. */
  html.g-webgl .g-head::before, html.g-webgl .g-focus::before {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--bg) 90%, transparent), color-mix(in srgb, var(--bg) 62%, transparent) 55%, transparent);
  }
  html.g-webgl .g-head::before { left: -40px; top: -100px; width: min(980px, 100%); height: 300px; }
  html.g-webgl .g-focus::before { left: -120px; right: -120px; top: -70px; bottom: -60px; }
  html.g-webgl .g-title, html.g-webgl .g-stats, html.g-webgl .g-focus {
    text-shadow: 0 0 14px var(--bg), 0 0 30px var(--bg);
  }
  html.g-webgl:not(.g-ready) .g-head { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    html.g-ready .g-title { animation: g-rise 1.1s cubic-bezier(.2,.8,.2,1) 0.35s both; }
    html.g-ready .g-stats { animation: g-rise 1.1s cubic-bezier(.2,.8,.2,1) 0.5s both; }
    html.g-ready .g-focus { animation: g-rise 1.1s cubic-bezier(.2,.8,.2,1) 0.8s both; }
    html.g-ready .g-controls { animation: g-rise 1.1s cubic-bezier(.2,.8,.2,1) 0.9s both; }
  }
  @keyframes g-rise { from { opacity: 0; transform: translateY(18px); } }

  /* The dish in the middle */
  html.g-webgl .g-focus {
    display: block;
    position: fixed;
    left: var(--g-edge);
    bottom: 30px;
    z-index: 5;
    max-width: min(560px, calc(100vw - 2 * var(--g-edge) - 360px));
    pointer-events: none;
  }
  html.g-webgl:not(.g-ready) .g-focus { opacity: 0; }
  .g-focus-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 6px;
    font-family: var(--serif);
    font-style: italic;
    color: var(--accent);
  }
  .g-focus-tags {
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .g-focus-title {
    display: grid;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.5vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .g-t { grid-area: 1 / 1; }
  .g-w { display: inline-flex; overflow: hidden; padding-bottom: 0.14em; margin-bottom: -0.14em; vertical-align: top; }
  .g-c { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    .g-c { animation: g-c-in 0.75s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(var(--k) * 14ms); }
    .g-t.out .g-c { animation: g-c-out 0.38s cubic-bezier(.5,0,.75,0) both; animation-delay: calc(var(--k) * 7ms); }
  }
  .g-t.out { pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { .g-t.out { display: none; } }
  @keyframes g-c-in { from { transform: translateY(115%); opacity: 0; } }
  @keyframes g-c-out { to { transform: translateY(-115%); opacity: 0; } }

  /* Loading */
  html.g-webgl .g-loader {
    display: grid;
    position: fixed;
    inset: 0;
    z-index: 4;
    place-content: center;
    justify-items: center;
    gap: 14px;
    pointer-events: none;
    transition: opacity 0.6s ease, visibility 0.6s;
  }
  html.g-ready .g-loader { opacity: 0; visibility: hidden; }
  .g-loader-num {
    font-family: var(--serif);
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .g-loader-bar { position: relative; width: 120px; height: 1px; overflow: hidden; background: var(--border); }
  .g-loader-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--text);
    transform-origin: 0 50%;
    transform: scaleX(var(--p, 0));
  }

  /* Hint */
  html.g-webgl .g-hint {
    display: block;
    position: fixed;
    right: var(--g-edge);
    bottom: 90px;
    z-index: 5;
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    pointer-events: none;
    transition: opacity 0.6s ease;
  }
  html.g-touched .g-hint, html.g-webgl:not(.g-ready) .g-hint, html.g-viewing .g-hint { opacity: 0; }
  html.g-webgl .g-head, html.g-webgl .g-focus, html.g-webgl .g-controls { transition: opacity 0.4s ease; }
  html.g-viewing .g-head, html.g-viewing .g-focus, html.g-viewing .g-controls, html.g-index-open .g-focus { opacity: 0; }
  .g-hint-touch { display: none; }

  /* Controls */
  html.g-webgl .g-controls {
    display: flex;
    position: fixed;
    right: var(--g-edge);
    bottom: 26px;
    z-index: 6;
    gap: 4px;
    padding: 5px;
    border: 1px solid color-mix(in srgb, var(--border) 85%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: 0 14px 34px -18px rgba(0, 0, 0, 0.4);
  }
  html.g-webgl:not(.g-ready) .g-controls { opacity: 0; }
  .g-seg { position: relative; display: flex; }
  .g-seg-thumb {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 50%;
    border-radius: 999px;
    background: var(--text);
    transition: transform 0.55s cubic-bezier(.2,.8,.2,1);
  }
  html.g-ring .g-seg-thumb { transform: translateX(100%); }
  .g-controls button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 16px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--text);
    font: 500 0.9rem/1.2 var(--sans);
    cursor: pointer;
    transition: color 0.35s ease, background 0.2s ease;
  }
  .g-controls svg { fill: currentColor; flex: none; }
  .g-seg button { flex: 1 1 0; min-width: 96px; }
  .g-seg button[aria-pressed='true'] { color: var(--bg); }
  .g-index-btn::before {
    content: '';
    position: absolute;
    left: -2px;
    top: 9px;
    bottom: 9px;
    width: 1px;
    background: var(--border);
  }
  .g-index-btn:hover, .g-index-btn[aria-expanded='true'] { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .g-controls button:focus-visible { outline-offset: 0; }

  /* Index */
  html.g-webgl .g-index {
    display: block;
    position: fixed;
    top: 76px;
    right: 16px;
    bottom: 92px;
    z-index: 7;
    width: min(380px, calc(100vw - 32px));
    padding: 16px 8px 8px;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 0.35s ease, transform 0.5s cubic-bezier(.2,.8,.2,1);
    outline: none;
  }
