---
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';

// Each dish is a Markdown file in src/content/gallery (see _template.md there).
const entries = (await getCollection('gallery')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const pad = (n: number) => String(n).padStart(2, '0');
const dishes = await Promise.all(
  entries.map(async (e, i) => {
    const large = await getImage({ src: e.data.image, width: 1600, format: 'webp', quality: 82 });
    const thumb = await getImage({ src: e.data.image, width: 360, format: 'webp', quality: 72 });
    return {
      ...e.data,
      id: e.id,
      no: pad(i + 1),
      large: large.src,
      thumb: thumb.src,
      recipeHref: e.data.recipe && `/recipes/${e.data.recipe.id}/`,
    };
  }),
);
const pizzaNights = dishes.filter((d) => d.tags.includes('pizza')).length;
---

<Base title="Gallery" description="Dishes Dylan has cooked at home: Neapolitan pizza, crunchwraps, crispy chicken and more.">
  <header class="cover">
    <div class="container cover-grid">
      <div class="cover-title">
        <p class="eyebrow rise" style="--i:0">Gallery</p>
        <h1 class="rise" style="--i:1">Cooked<br /><em>at home.</em></h1>
        <dl class="stats rise" style="--i:2">
          <div><dt>Dishes</dt><dd data-count={dishes.length}>{dishes.length}</dd></div>
          <div><dt>Pizza nights</dt><dd data-count={pizzaNights}>{pizzaNights}</dd></div>
          <div><dt>Heart-shaped</dt><dd data-count="1">1</dd></div>
        </dl>
      </div>

      <nav class="contents rise" style="--i:3" aria-label="Dishes">
        <p class="contents-head"><span>Contents</span><span>{pad(dishes.length)}</span></p>
        <ol>
          {
            dishes.map((d) => (
              <li>
                <a href={`#${d.id}`} data-thumb={d.thumb}>
                  <span class="c-no">{d.no}</span>
                  <span class="c-title">{d.title}</span>
                  <span class="c-dots" aria-hidden="true" />
                  <span class="c-tag">{d.tags[0]}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
    <img class="peek" alt="" aria-hidden="true" />
  </header>

  <div class="dishes">
    {
      dishes.map((d, i) => (
        <article class:list={['dish', { flip: i % 2 === 1 }]} id={d.id}>
          <div class="container dish-grid">
            <div class="frame" data-reveal>
              <button
                class="plate"
                type="button"
                data-index={i}
                data-title={d.title}
                data-caption={d.caption}
                data-tags={d.tags.join(',')}
                data-large={d.large}
                data-alt={d.alt}
                data-no={d.no}
                data-recipe={d.recipeHref || undefined}
                aria-label={`View larger: ${d.title}`}
              >
                <Picture
                  src={d.image}
                  widths={[600, 900, 1300]}
                  sizes="(max-width: 820px) 100vw, 620px"
                  formats={['avif', 'webp']}
                  alt={d.alt}
                  loading={i < 1 ? 'eager' : 'lazy'}
                />
              </button>
            </div>
            <div class="text" data-reveal style="--d:1">
              <p class="no">
                <span>Nº {d.no}</span>
                <span class="kinds">{d.tags.join(' · ')}</span>
              </p>
              <h2>{d.title}</h2>
              <p class="caption">{d.caption}</p>
              {d.recipeHref && (
                <a class="recipe" href={d.recipeHref}>
                  Read the recipe <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <dialog class="lightbox" aria-label="Dish photo">
    <div class="lb-inner">
      <figure>
        <div class="lb-frame"><img class="lb-img" alt="" decoding="async" /></div>
        <figcaption>
          <span class="lb-count"></span>
          <h2 class="lb-title"></h2>
          <p class="lb-caption"></p>
          <a class="btn primary lb-recipe" hidden>Read the recipe →</a>
        </figcaption>
      </figure>
      <button class="lb-btn lb-prev" type="button" aria-label="Previous dish">←</button>
      <button class="lb-btn lb-next" type="button" aria-label="Next dish">→</button>
      <button class="lb-btn lb-close" type="button" aria-label="Close">✕</button>
    </div>
  </dialog>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  type VT = { finished: Promise<void> };
  const vt = (fn: () => void): Promise<void> => {
    const start = (document as Document & { startViewTransition?: (cb: () => void) => VT }).startViewTransition;
    if (reduce || !start) {
      fn();
      return Promise.resolve();
    }
    return start.call(document, fn).finished.catch(() => {});
  };

  /* ---------- Count-up stats ---------- */
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el, k) => {
      const end = Number(el.dataset.count);
      const t0 = performance.now() + 500 + k * 120;
      el.textContent = '0';
      const step = (t: number) => {
        const p = Math.min(Math.max((t - t0) / 900, 0), 1);
        el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }

  /* ---------- Contents: a small photo follows the cursor over each row ---------- */
  const peek = document.querySelector<HTMLImageElement>('.peek')!;
  if (fine && !reduce) {
    let x = 0, y = 0, px = 0, py = 0, raf = 0;
    const tick = () => {
      px += (x - px) * 0.18;
      py += (y - py) * 0.18;
      peek.style.transform = `translate3d(${px}px, ${py}px, 0) rotate(${(x - px) * 0.08}deg)`;
      raf = requestAnimationFrame(tick);
    };
    document.querySelectorAll<HTMLAnchorElement>('.contents a').forEach((a) => {
      a.addEventListener('pointerenter', (e) => {
        peek.src = a.dataset.thumb!;
        if (!peek.classList.contains('on')) ((px = x = e.clientX + 24), (py = y = e.clientY - 80));
        peek.classList.add('on');
        if (!raf) tick();
      });
      a.addEventListener('pointermove', (e) => ((x = e.clientX + 24), (y = e.clientY - 80)));
      a.addEventListener('pointerleave', () => peek.classList.remove('on'));
    });
    document.querySelector('.contents')!.addEventListener('pointerleave', () => {
      cancelAnimationFrame(raf);
      raf = 0;
    });
  }

  /* ---------- Lightbox ---------- */
  const plates = [...document.querySelectorAll<HTMLButtonElement>('.plate')];
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dlg.querySelector<HTMLImageElement>('.lb-img')!;
  const title = dlg.querySelector<HTMLElement>('.lb-title')!;
  const caption = dlg.querySelector<HTMLElement>('.lb-caption')!;
  const count = dlg.querySelector<HTMLElement>('.lb-count')!;
  const recipe = dlg.querySelector<HTMLAnchorElement>('.lb-recipe')!;
  let current = -1;
  const thumbOf = (p: HTMLElement) => p.querySelector('img')!;

  function fill(i: number) {
    const d = plates[i].dataset;
    current = i;
    img.src = d.large!;
    img.alt = d.alt!;
    title.textContent = d.title!;
    caption.textContent = d.caption!;
    count.textContent = `Nº ${d.no} / ${String(plates.length).padStart(2, '0')}`;
    recipe.hidden = !d.recipe;
    if (d.recipe) recipe.href = d.recipe;
  }

  async function open(i: number) {
    const th = thumbOf(plates[i]);
    th.style.viewTransitionName = 'dish-photo';
    fill(i);
    await img.decode().catch(() => {});
    await vt(() => {
      th.style.viewTransitionName = '';
      img.style.viewTransitionName = 'dish-photo';
      dlg.showModal();
      document.documentElement.classList.add('lb-open');
    });
    img.style.viewTransitionName = '';
  }

  async function close() {
    const plate = plates[current];
    // Morph back only if the dish is on screen; otherwise just fade out.
    const r = plate?.getBoundingClientRect();
    const onScreen = r && r.bottom > 0 && r.top < innerHeight;
    if (onScreen) img.style.viewTransitionName = 'dish-photo';
    await vt(() => {
      img.style.viewTransitionName = '';
      if (onScreen) thumbOf(plate).style.viewTransitionName = 'dish-photo';
      dlg.close();
      document.documentElement.classList.remove('lb-open');
    });
    if (plate) {
      thumbOf(plate).style.viewTransitionName = '';
      plate.focus({ preventScroll: true });
    }
  }

  async function go(dir: 1 | -1) {
    const next = (current + dir + plates.length) % plates.length;
    const pre = new Image();
    pre.src = plates[next].dataset.large!;
    await pre.decode().catch(() => {});
    vt(() => fill(next));
    // Keep the page underneath in step, so closing lands on the dish you were viewing.
    plates[next].closest('.dish')!.scrollIntoView({ block: 'center', behavior: 'instant' as ScrollBehavior });
  }

  plates.forEach((p, i) => p.addEventListener('click', () => open(i)));
  dlg.querySelector('.lb-close')!.addEventListener('click', close);
  dlg.querySelector('.lb-prev')!.addEventListener('click', () => go(-1));
  dlg.querySelector('.lb-next')!.addEventListener('click', () => go(1));
  dlg.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg || (e.target as Element).classList.contains('lb-inner')) close();
  });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') go(1);
    if (e.key === 'ArrowLeft') go(-1);
  });

  let sx = 0, sy = 0;
  dlg.addEventListener('touchstart', (e) => ((sx = e.touches[0].clientX), (sy = e.touches[0].clientY)), { passive: true });
  dlg.addEventListener(
    'touchend',
    (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      const dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) go(dx < 0 ? 1 : -1);
    },
    { passive: true },
  );
</script>

<style>
  /* ---------- Cover ---------- */
  .cover { padding: 72px 0 40px; }
  .cover-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 64px;
    align-items: end;
  }
  .cover h1 {
    font-size: clamp(3.2rem, 9vw, 6.6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .cover h1 em { color: var(--accent); font-weight: 500; }
  .stats { display: flex; gap: 16px 36px; margin: 36px 0 0; flex-wrap: wrap; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dt { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .stats dd {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .contents { border-top: 1.5px solid var(--text); }
  .contents-head {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 10px 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .contents ol { list-style: none; margin: 0; padding: 0; }
  .contents a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 9px 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
  }
  .c-no { font-family: var(--serif); font-style: italic; color: var(--muted); font-size: 0.9rem; min-width: 1.6em; }
  .c-title { font-family: var(--serif); font-size: 1.12rem; transition: transform 0.35s cubic-bezier(.2,.8,.2,1), color 0.2s ease; }
  .c-dots { flex: 1; min-width: 16px; border-bottom: 1px dotted color-mix(in srgb, var(--muted) 60%, transparent); transform: translateY(-4px); }
  .c-tag { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .contents a:hover .c-title, .contents a:focus-visible .c-title { transform: translateX(8px); color: var(--accent); }

  .peek {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    width: 150px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 10px;
    box-shadow: 0 24px 40px -18px rgba(0, 0, 0, 0.55);
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    transition: opacity 0.25s ease, scale 0.35s cubic-bezier(.2,.8,.2,1);
  }
  .peek:not([src]) { display: none; }
  .peek.on { opacity: 1; scale: 1; }

  /* ---------- Dishes ---------- */
  .dish { padding: clamp(48px, 9vw, 120px) 0; }
  .dish + .dish { border-top: 1px solid var(--border); }
  .dish-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .flip .dish-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); }
  .flip .frame { order: 2; }
  .dish { scroll-margin-top: 24px; }

  .frame { position: relative; width: 100%; max-width: calc(80vh * 0.75); justify-self: center; }
  .plate {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 6px;
    overflow: hidden;
    background: var(--border);
    cursor: zoom-in;
    box-shadow: 0 40px 70px -40px rgba(0, 0, 0, 0.55);
  }
  .plate :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 1.2s cubic-bezier(.2,.8,.2,1);
  }
  .plate:hover :global(img) { transform: scale(1.035); }
  .plate:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }

  .text { max-width: 420px; }
  .no {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 1.4rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--accent);
  }
  .no::after { content: ''; flex: 1; max-width: 80px; height: 1px; background: currentColor; opacity: 0.5; order: 1; }
  .kinds {
    order: 2;
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .text h2 { font-size: clamp(2rem, 4.2vw, 3.1rem); line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 0.5em; }
  .caption { color: var(--muted); font-size: 1.08rem; line-height: 1.7; }
  .recipe { font-weight: 500; text-decoration: none; }
  .recipe span { display: inline-block; transition: transform 0.25s ease; }
  .recipe:hover span { transform: translateX(4px); }

  /* Photos uncover as they scroll into view, then drift slightly (where supported). */
  @media (prefers-reduced-motion: no-preference) {
    .js .frame[data-reveal] { transform: none; }
    .js .frame[data-reveal] .plate {
      clip-path: inset(12% 8% 12% 8% round 6px);
      transition: clip-path 1.3s cubic-bezier(.2,.8,.2,1);
    }
    .js .frame[data-reveal].in .plate { clip-path: inset(0 0 0 0 round 6px); }
    @supports (animation-timeline: view()) {
      .frame { animation: drift linear both; animation-timeline: view(); }
      @keyframes drift { from { translate: 0 40px; } to { translate: 0 -40px; } }
    }
  }

  /* ---------- Lightbox ---------- */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #f2f0ea;
  }
  .lightbox::backdrop { background: rgba(8, 9, 8, 0.9); backdrop-filter: blur(14px) saturate(0.8); }
  :global(html.lb-open) { overflow: hidden; }
  .lb-inner { position: relative; height: 100%; display: grid; place-items: center; padding: 64px 84px; }
  .lightbox figure {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(220px, 300px);
    align-items: end;
    gap: 36px;
    max-height: 100%;
  }
  .lb-frame { min-height: 0; }
  .lb-img {
    display: block;
    max-width: min(62vw, 900px);
    max-height: calc(100dvh - 128px);
    width: auto;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.8);
  }
  .lb-count { font-family: var(--serif); font-style: italic; color: #e0a36a; letter-spacing: 0.04em; }
  .lb-title { font-size: clamp(1.6rem, 3vw, 2.3rem); margin: 0.3em 0 0.4em; }
  .lb-caption { color: rgba(242, 240, 234, 0.75); }
  .lb-recipe[hidden] { display: none; }
  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.06);
    color: #f2f0ea;
    font-size: 1.15rem;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .lb-btn:hover { background: rgba(255, 255, 255, 0.16); transform: scale(1.06); }
  .lb-prev { left: 20px; top: 50%; margin-top: -24px; }
  .lb-next { right: 20px; top: 50%; margin-top: -24px; }
  .lb-close { right: 20px; top: 20px; }

  ::view-transition-group(dish-photo) { animation-duration: 520ms; animation-timing-function: cubic-bezier(.2,.8,.2,1); }
  ::view-transition-old(dish-photo), ::view-transition-new(dish-photo) { height: 100%; object-fit: cover; }

  /* ---------- Entrance ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .rise { opacity: 0; animation: up 1s cubic-bezier(.2,.8,.2,1) forwards; animation-delay: calc(80ms + var(--i) * 120ms); }
  }
  @keyframes up { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .plate :global(img) { transition: none; }
  }

  /* ---------- Small screens ---------- */
  @media (max-width: 820px) {
    .cover { padding-top: 40px; }
    .cover-grid { grid-template-columns: 1fr; gap: 40px; }
    .dish-grid { grid-template-columns: 1fr; gap: 28px; }
    .flip .dish-grid { grid-template-columns: 1fr; }
    .flip .frame { order: 0; }
    .frame { max-width: none; }
    .text { max-width: none; }
    .lb-inner { padding: 64px 16px 24px; place-items: start center; overflow-y: auto; }
    .lightbox figure { grid-template-columns: 1fr; gap: 18px; }
    .lb-img { max-width: 100%; max-height: 62dvh; margin: 0 auto; }
    .lb-prev, .lb-next { top: auto; bottom: 16px; margin: 0; }
    .lb-prev { left: auto; right: 76px; }
  }
  @media (max-width: 480px) {
    .c-tag { display: none; }
    .stats { column-gap: 22px; margin-top: 28px; }
    .stats dt { font-size: 0.66rem; letter-spacing: 0.1em; }
  }
</style>
