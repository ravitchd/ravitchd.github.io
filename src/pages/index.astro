---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { SITE } from '../site';

const projects = (await getCollection('projects'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const recipes = (await getCollection('recipes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{SITE.role}</p>
      <h1>Hi, I'm {SITE.name.split(' ')[0]}.</h1>
      <p class="lede">{SITE.tagline}</p>
      <div class="actions">
        <a class="btn primary" href="/resume/">View resume</a>
        <a class="btn" href="/projects/">See projects</a>
        {SITE.github && <a class="btn" href={SITE.github}>GitHub</a>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Selected projects</h2>
        <a href="/projects/">All projects →</a>
      </div>
      <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>From the kitchen</h2>
        <a href="/recipes/">All recipes →</a>
      </div>
      <div class="grid">{recipes.map((r) => <RecipeCard recipe={r} />)}</div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(64px, 12vw, 128px) 0 40px; }
  .hero h1 { max-width: 14ch; }
  .lede { font-size: clamp(1.1rem, 2.2vw, 1.3rem); color: var(--muted); max-width: 40ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
</style>
