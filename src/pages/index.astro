---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import { SITE } from '../site';
import portrait from '../assets/dylan-portrait.jpg';
import fishing from '../assets/dylan-fishing.jpg';
import { experience } from '../data/resume';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf(),
);
const recipeCount = (await getCollection('recipes')).length;
const dishes = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const kitchen = dishes.slice(0, 4);

const year = (d: Date) => d.getUTCFullYear();

const stories = [
  ...allProjects.filter((p) => p.data.featured).map((p) => ({
    href: `/projects/${p.id}/`,
    title: p.data.title,
    dek: p.data.summary,
    when: String(year(p.data.date)),
  })),
  { href: '/prints/', title: '3D models', dek: 'Parts I have designed in CAD, from an M6 bolt to my capstone container, viewable in 3D.', when: '3D Design' },
  { href: '/aerospace/', title: 'Rockets', dek: 'Full 3D assemblies of the Spaceport America Cup rocket and a test rocket.', when: 'Aerospace' },
  { href: '/recipes/', title: 'Recipes', dek: `${recipeCount} of my recipes, written up with ingredients and steps.`, when: 'Cooking' },
];

const firstName = SITE.name.split(' ')[0];
const lastName = SITE.name.split(' ').slice(1).join(' ');
const now = experience[0];
---

<Base>
  <div class="ed">
    <div class="container">
      <p class="eyebrow tag-line">{SITE.role} · {SITE.location}</p>
      <h1 class="mast" aria-label={SITE.name}>{firstName} <em>{lastName}</em></h1>

      <div class="spread">
        <div class="dekcol">
          <p class="dek">
            I design fluid delivery systems for semiconductor fabs.
          </p>
          <dl class="facts">
            <div><dt>Now</dt><dd>{now.role}, {now.org}</dd></div>
            <div><dt>Studied</dt><dd>B.S. Mechanical Engineering, Washington State, 2025</dd></div>
            <div><dt>Based in</dt><dd>{SITE.location}</dd></div>
          </dl>
        </div>
        <figure class="cover">
          <Picture
            src={portrait}
            widths={[400, 640, 880]}
            sizes="(max-width: 860px) 100vw, 380px"
            formats={['avif', 'webp']}
            alt="Dylan in a dark suit and patterned tie, checking his watch"
            loading="eager"
          />
        </figure>
        <div class="body">
          <p>
            At SSOE I route high-pressure and hazardous gas for semiconductor fabrication facilities, choose pipe classes
            and materials for chemical compatibility, and take part in constructability reviews.
          </p>
          <p>
            Before that I grew silicon ingots in vacuum furnaces, drew sheet metal for Intel and LAM Research, and helped
            put a rocket into the top three of its category at Spaceport America Cup.
          </p>
          <div class="cta">
            <a class="btn primary" href="/resume/">Read the resume</a>
            <a class="more" href="/projects/">All projects →</a>
          </div>
        </div>
      </div>
    </div>

    <section class="container toc-wrap">
      <div class="head"><h2>Selected work</h2></div>
      <ul class="toc">
        {
          stories.map((s) => (
            <li>
              <a href={s.href}>
                <span class="t">
                  <h3>{s.title}</h3>
                  <p>{s.dek}</p>
                </span>
                <span class="when">{s.when}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="container feature">
      <figure>
        <Picture
          src={fishing}
          widths={[420, 640, 840]}
          sizes="(max-width: 860px) 100vw, 420px"
          formats={['avif', 'webp']}
          alt="Dylan in a green rain jacket fishing from a beach while an aircraft carrier passes in the fog"
        />
        <figcaption>Fishing from the beach as an aircraft carrier passes in the fog.</figcaption>
      </figure>
      <div class="feature-copy">
        <p class="eyebrow">Outside work</p>
        <h2>Fishing and cooking</h2>
        <p class="lead">I fish, and I cook a lot, mostly pizza.</p>
        <p>
          {recipeCount} of my recipes are written up on this site so far, from bagels to lasagna, along with photos of
          dishes I have made.
        </p>
        <div class="cta">
          <a class="btn" href="/recipes/">Recipes</a>
          <a class="more" href="/gallery/">Gallery →</a>
        </div>
      </div>
    </section>

    <section class="container kitchen">
      <div class="head"><h2>A few dishes</h2><a href="/gallery/">Gallery →</a></div>
      <div class="plates">
        {
          kitchen.map((d, i) => (
            <a href={d.data.recipe ? `/recipes/${d.data.recipe.id}/` : '/gallery/'} class="plate" style={`--d:${i}`}>
              <Picture src={d.data.image} widths={[300, 480, 640]} sizes="(max-width: 760px) 50vw, 260px" formats={['avif', 'webp']} alt={d.data.alt} />
              <span class="cap">{d.data.title}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>

</Base>

<style>
  .ed { padding-top: 6px; }
  .tag-line { margin: 34px 0 0; }
  .mast em { color: var(--accent); }
  .mast {
    font-size: clamp(4rem, 15.5vw, 13.5rem);
    line-height: 0.82;
    letter-spacing: -0.025em;
    margin: 18px 0 0;
    white-space: nowrap;
  }

  .spread {
    display: grid;
    grid-template-columns: 1fr 1fr 0.95fr;
    gap: 40px;
    padding: 40px 0 64px;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .dek { font-family: var(--display); font-size: clamp(1.7rem, 2.6vw, 2.1rem); line-height: 1.12; margin: 0 0 24px; }
  .facts { margin: 0; border-top: 1px solid var(--border); }
  .facts div { display: grid; grid-template-columns: 5.5rem 1fr; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
  .facts dt { font-weight: 600; }
  .facts dd { margin: 0; color: var(--muted); }
  .cover { margin: 0; }
  .cover :global(img) { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  figcaption { font-size: 0.8rem; color: var(--muted); margin-top: 10px; }
  .body p { line-height: 1.7; font-size: 1.02rem; }
  .cta { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; margin-top: 24px; }
  .more { color: var(--text); font-weight: 600; text-decoration: none; border-bottom: 1.5px solid var(--rule); padding-bottom: 2px; }
  .more:hover { color: var(--accent); border-color: var(--accent); }


  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; border-bottom: 1px solid var(--rule); padding-bottom: 12px; margin-bottom: 4px; }
  .head h2 { margin: 0; }
  .head a { color: var(--text); text-decoration: none; font-weight: 500; font-size: 0.92rem; }
  .head a:hover { color: var(--accent); }


  .toc-wrap { padding-bottom: 88px; position: relative; }
  .toc { list-style: none; margin: 0; padding: 0; }
  .toc a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: padding 0.3s cubic-bezier(.2,.8,.2,1), color 0.2s ease;
  }
  .toc a:hover { padding-left: 14px; color: var(--accent); }
  .toc h3 { font-size: clamp(1.8rem, 3.8vw, 3rem); line-height: 1; margin: 0; }
  .toc p { margin: 8px 0 0; color: var(--muted); font-size: 0.95rem; max-width: 42rem; }
  .toc .when { font-size: 0.8rem; color: var(--muted); font-weight: 500; }

  .feature { display: grid; grid-template-columns: 420px 1fr; gap: 64px; align-items: center; padding-bottom: 88px; }
  .feature figure { margin: 0; }
  .feature :global(img) { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .feature h2 { font-size: clamp(2.4rem, 4.6vw, 3.8rem); line-height: 1; }
  .lead { font-family: var(--display); font-size: 1.6rem; line-height: 1.2; }
  .feature-copy > p:not(.lead):not(.eyebrow) { color: var(--muted); max-width: 34rem; }

  .kitchen { padding-bottom: 24px; }
  .plates { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 22px; }
  .plate { color: inherit; text-decoration: none; }
  .plate :global(img) { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; transition: filter 0.3s ease; }
  .plate:hover :global(img) { filter: brightness(1.06) saturate(1.08); }
  .plate .cap { display: block; font-family: var(--display); font-size: 1.2rem; line-height: 1.15; margin-top: 10px; }
  .plate:hover .cap { color: var(--accent); }

  @media (max-width: 960px) {
    .spread { grid-template-columns: 1fr 1fr; }
    .body { grid-column: 1 / -1; }
    .feature { grid-template-columns: 1fr 1fr; gap: 40px; }
  }
  @media (max-width: 680px) {
    .mast { white-space: normal; margin-top: 20px; }
    .spread { grid-template-columns: 1fr; gap: 28px; padding-top: 28px; }
    .toc a { grid-template-columns: 1fr; gap: 12px; }
    .toc .when { display: none; }
    .feature { grid-template-columns: 1fr; }
    .plates { grid-template-columns: 1fr 1fr; gap: 12px; }
  }

</style>
