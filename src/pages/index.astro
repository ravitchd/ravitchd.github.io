---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { Picture } from 'astro:assets';
import { SITE } from '../site';
import portrait from '../assets/dylan-portrait.jpg';
import fishing from '../assets/dylan-fishing.jpg';
import { experience, skills } from '../data/resume';

const projects = (await getCollection('projects'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const recipes = (await getCollection('recipes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const marquee = ['Fluid delivery systems', 'Hazardous gas routing', 'Semiconductor fabs', 'SolidWorks FEA', 'Rocket airframes', 'Wind tunnel testing', 'Design for manufacturing', 'Pizza night'];

const stats = [
  { value: experience.length, suffix: '', label: 'engineering roles, from the shop floor to fab design' },
  { value: skills.length, suffix: '', label: 'CAD, analysis and design tools I work in' },
  { value: 3, suffix: 'rd', label: 'in category at Spaceport America Cup 2022' },
  { value: 2025, suffix: '', label: 'B.S. Mechanical Engineering, Washington State University' },
];

const greeting = `Hi, I'm ${SITE.name.split(' ')[0]}.`;
let n = 0;
const words = greeting.split(' ').map((w) => [...w].map((ch) => ({ ch, i: n++ })));
---

<Base>
  <section class="hero">
    <canvas class="field" data-field aria-hidden="true"></canvas>
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container hero-inner">
      <div class="hero-copy">
      <p class="eyebrow intro" style="--i:0"><span class="pulse" aria-hidden="true"></span>{SITE.role}</p>
      <h1 aria-label={greeting}>
        {
          words.map((w) => (
            <span class="word" aria-hidden="true">
              {w.map(({ ch, i }) => (
                <span class="ch" style={`--c:${i}`}>{ch}</span>
              ))}
            </span>
          ))
        }
      </h1>
      <p class="lede intro" style="--i:1">
        {SITE.rotatingPrefix} <span class="rotator" data-rotate={JSON.stringify(SITE.rotating)}>{SITE.rotating[0]}</span>
      </p>
      <p class="sub intro" style="--i:2">{SITE.tagline}</p>
      <div class="actions intro" style="--i:3">
        <a class="btn primary" href="/resume/">View resume</a>
        <a class="btn" href="/projects/">See projects</a>
        {SITE.github && <a class="btn" href={SITE.github}>GitHub</a>}
      </div>
      </div>

      <div class="portrait-wrap" data-tilt>
        <div class="portrait">
          <span class="ring" aria-hidden="true"></span>
          <Picture
            src={portrait}
            widths={[420, 640, 960]}
            sizes="(max-width: 900px) 70vw, 420px"
            formats={['avif', 'webp']}
            alt="Portrait of Dylan in a dark suit and paisley tie, checking his watch"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <span class="chip c1" data-depth="40"><b>SSOE</b> Mechanical Engineer 2</span>
        <span class="chip c2" data-depth="-30"><b>WSU</b> B.S. ME, 2025</span>
        <span class="chip c3" data-depth="55"><b>🚀</b> 3rd in category, SA Cup</span>
      </div>
    </div>
    <a class="scroll-cue" href="#work" aria-label="Scroll to projects"><span></span></a>
  </section>

  <div class="marquee" data-marquee aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <div class="marquee-row">
            {marquee.map((m) => (
              <span>
                {m}
                <i>✦</i>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <section class="section about" id="about">
    <div class="container about-grid">
      <div class="about-copy">
        <p class="eyebrow" data-reveal>About me</p>
        <h2 class="split" data-reveal style="--d:1">Nice to meet you.</h2>
        <p data-reveal style="--d:2">
          I'm a mechanical engineer at SSOE in Hillsboro, Oregon, designing fluid delivery systems for semiconductor fabs: high-pressure
          and hazardous gas routing, pipe classes and materials, and plenty of constructability reviews.
        </p>
        <p data-reveal style="--d:3">
          I studied mechanical engineering at Washington State University Vancouver. Outside of work I'm usually in the kitchen, mostly
          making pizza. You can see what I've been cooking in the <a href="/gallery/">gallery</a>.
        </p>
      </div>
      <ul class="stats">
        {
          stats.map((st, i) => (
            <li data-reveal style={`--d:${i}`}>
              <strong>
                <span data-count={st.value}>{st.value}</span>
                {st.suffix && <sup>{st.suffix}</sup>}
              </strong>
              <span>{st.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="reel" data-reel>
    <div class="reel-stage">
      <figure class="reel-frame">
        <Picture
          src={fishing}
          widths={[800, 1300, 1800]}
          sizes="100vw"
          formats={['avif', 'webp']}
          alt="Dylan in a green rain jacket fishing from a beach while an aircraft carrier passes in the fog"
        />
        <figcaption class="reel-copy">
          <p class="eyebrow">Off the clock</p>
          <p class="reel-line">When I'm not routing gas lines, I'm on the water with a rod or in the kitchen with a pizza peel.</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="work">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Selected projects</h2>
        <a href="/projects/">All projects →</a>
      </div>
      <div class="grid">{projects.map((p, i) => <ProjectCard project={p} index={i} />)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>From the kitchen</h2>
        <a href="/recipes/">All recipes →</a>
      </div>
      <div class="grid">{recipes.map((r, i) => <RecipeCard recipe={r} index={i} />)}</div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/home';
</script>

<style>
  .hero {
    position: relative;
    min-height: min(92vh, 860px);
    display: flex;
    align-items: center;
    overflow: hidden;
    margin-top: -64px;
    padding: 120px 0 80px;
    isolation: isolate;
  }
  .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    -webkit-mask-image: radial-gradient(ellipse 75% 70% at 65% 45%, #000 30%, transparent 80%);
    mask-image: radial-gradient(ellipse 75% 70% at 65% 45%, #000 30%, transparent 80%);
  }
  .aurora {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.7;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  .aurora span {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--blob), transparent);
    animation: drift 18s ease-in-out infinite alternate;
  }
  .aurora span:nth-child(1) { width: 640px; height: 640px; left: 50%; top: 0%; --blob: color-mix(in srgb, var(--accent) 30%, transparent); }
  .aurora span:nth-child(2) { width: 520px; height: 520px; left: 68%; top: 40%; --blob: color-mix(in srgb, #d9a441 26%, transparent); animation-delay: -6s; animation-duration: 22s; }
  .aurora span:nth-child(3) { width: 460px; height: 460px; left: 32%; top: 45%; --blob: color-mix(in srgb, #7aa6c2 22%, transparent); animation-delay: -12s; animation-duration: 26s; }
  @keyframes drift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-60px, 40px) scale(1.12); }
    100% { transform: translate(40px, -30px) scale(0.95); }
  }

  .hero h1 { font-size: clamp(2.8rem, 8vw, 5.6rem); margin-bottom: 0.3em; max-width: none; }
  .word { display: inline-block; white-space: nowrap; margin-right: 0.22em; }
  .ch { display: inline-block; }
  .lede { font-family: var(--serif); font-size: clamp(1.4rem, 3.4vw, 2.1rem); line-height: 1.25; margin-bottom: 0.6em; }
  .rotator {
    display: inline-block;
    color: var(--accent);
    font-style: italic;
    transition: opacity 0.38s ease, transform 0.38s cubic-bezier(.2,.8,.2,1), filter 0.38s ease;
  }
  .rotator:global(.out) { opacity: 0; transform: translateY(-0.4em); filter: blur(6px); }
  .rotator:global(.in) { opacity: 0; transform: translateY(0.4em); filter: blur(6px); transition: none; }
  .sub { color: var(--muted); max-width: 44ch; font-size: 1.05rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  .pulse {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 1px;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse { 70%, 100% { box-shadow: 0 0 0 10px transparent; } }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 28px;
    width: 24px;
    height: 38px;
    margin-left: -12px;
    border: 1.5px solid var(--muted);
    border-radius: 14px;
    opacity: 0.6;
  }
  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 7px;
    width: 3px;
    height: 7px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--muted);
    animation: cue 1.8s ease-in-out infinite;
  }
  @keyframes cue { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(12px); } }

  @media (prefers-reduced-motion: no-preference) {
    .portrait-wrap { animation: fade-up 1.1s cubic-bezier(.2,.8,.2,1) 0.3s both; }
    .portrait :global(img) { animation: unveil 1.4s cubic-bezier(.7,0,.2,1) 0.45s both; }
    .chip { animation: chip-in 0.8s cubic-bezier(.2,.8,.2,1) both, bob 5s ease-in-out infinite alternate; }
    .c1 { animation-delay: 1.1s, 1.9s; }
    .c2 { animation-delay: 1.3s, 2.6s; }
    .c3 { animation-delay: 1.5s, 3.1s; }
    .ch {
      opacity: 0;
      transform: translateY(0.5em) rotate(6deg);
      filter: blur(8px);
      animation: rise 0.9s cubic-bezier(.2,.8,.2,1) forwards;
      animation-delay: calc(250ms + var(--c) * 38ms);
    }
    .intro {
      opacity: 0;
      animation: fade-up 0.9s cubic-bezier(.2,.8,.2,1) forwards;
      animation-delay: calc(700ms + var(--i) * 120ms);
    }
    .intro.eyebrow { animation-delay: 100ms; }
  }
  @media (prefers-reduced-motion: reduce) {
    .aurora span, .pulse, .scroll-cue span { animation: none; }
  }
  @keyframes unveil {
    from { clip-path: inset(100% 0 0 0 round 23px); scale: 1.12; }
    to { clip-path: inset(0 0 0 0 round 23px); scale: 1; }
  }
  @keyframes chip-in { from { opacity: 0; scale: 0.7; } to { opacity: 1; scale: 1; } }
  @keyframes bob { from { translate: 0 -6px; } to { translate: 0 6px; } }
  @keyframes rise { to { opacity: 1; transform: none; filter: none; } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  /* Hero layout with portrait */
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr); gap: 48px; align-items: center; }
  .portrait-wrap { position: relative; justify-self: center; width: min(420px, 100%); perspective: 1000px; }
  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    padding: 6px;
    transform-style: preserve-3d;
    transition: transform 0.25s cubic-bezier(.2,.8,.2,1);
  }
  .portrait :global(img) {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 23px;
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6);
  }
  .ring {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
  }
  .ring::before {
    content: '';
    position: absolute;
    inset: -50%;
    background: conic-gradient(from 0deg, var(--accent), #d9a441, #7aa6c2, var(--accent));
    animation: spin 7s linear infinite;
  }
  @keyframes spin { to { transform: rotate(1turn); } }
  .chip {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    box-shadow: 0 14px 30px -16px rgba(0, 0, 0, 0.45);
    font-size: 0.84rem;
    white-space: nowrap;
    transition: transform 0.3s cubic-bezier(.2,.8,.2,1);
  }
  .chip b { color: var(--accent); font-weight: 700; }
  .c1 { top: 9%; left: -18%; }
  .c2 { top: 52%; right: -16%; }
  .c3 { bottom: 6%; left: -10%; }

  /* Marquee band, skews with scroll speed */
  .marquee {
    overflow: hidden;
    padding: 22px 0;
    border-block: 1px solid var(--border);
    background: var(--surface);
  }
  .marquee-track { display: flex; width: max-content; will-change: transform; }
  .marquee-row { display: flex; }
  .marquee-row span {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    font-weight: 600;
    white-space: nowrap;
    padding-right: 0.6em;
  }
  .marquee-row span:nth-child(even) { color: transparent; -webkit-text-stroke: 1.2px var(--text); }
  .marquee-row i { font-style: normal; color: var(--accent); font-size: 0.6em; vertical-align: 0.35em; margin-left: 0.6em; }

  /* About + stats */
  .about-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  .about-copy p:not(.eyebrow) { color: var(--muted); font-size: 1.05rem; }
  .about-copy h2 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .stats li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .stats strong {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 5vw, 3rem);
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .stats sup { font-size: 0.45em; margin-left: 2px; }
  .stats li > span { color: var(--muted); font-size: 0.9rem; line-height: 1.4; }

  /* Fishing reel: the photo grows from a card to full-bleed as you scroll */
  .reel { position: relative; }
  .reel-frame { position: relative; margin: 0; overflow: hidden; }
  .reel-frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 28% 50%; transform-origin: 28% 50%; }
  .reel-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 35%, rgba(10, 14, 16, 0.65) 100%);
    pointer-events: none;
  }
  .reel-copy {
    position: absolute;
    z-index: 1;
    right: clamp(20px, 6vw, 80px);
    bottom: clamp(24px, 8vh, 80px);
    max-width: min(460px, 80%);
    color: #f4f2ec;
  }
  .reel-copy .eyebrow { color: #cfe6dc; }
  .reel-line { font-family: var(--serif); font-size: clamp(1.3rem, 3vw, 2.1rem); line-height: 1.25; margin: 0; }

  :global(.js) .reel.live { height: 220vh; }
  :global(.js) .reel.live .reel-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  :global(.js) .reel.live .reel-frame {
    width: 100%;
    height: 100%;
    clip-path: inset(calc((1 - var(--p, 0)) * 12%) calc((1 - var(--p, 0)) * 16%) round calc((1 - var(--p, 0)) * 28px));
  }
  :global(.js) .reel.live .reel-frame :global(img) { transform: scale(calc(1.18 - var(--p, 0) * 0.18)); }
  :global(.js) .reel.live .reel-copy {
    opacity: clamp(0, calc(var(--p, 0) * 2.5 - 1.2), 1);
    transform: translateY(calc((1 - var(--p, 0)) * 40px));
  }
  .reel:not(.live) .reel-frame { aspect-ratio: 16 / 9; max-height: 80vh; width: 100%; }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 56px; }
    .portrait-wrap { width: min(340px, 78%); }
    .c1 { left: -14%; }
    .c2 { right: -14%; }
  }
  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 480px) {
    .stats { grid-template-columns: 1fr 1fr; gap: 10px; }
    .stats li { padding: 16px; }
    .chip { font-size: 0.74rem; padding: 0.45rem 0.75rem; }
    .reel:not(.live) .reel-frame { aspect-ratio: 4 / 3; }
    .reel-frame :global(img) { object-position: 8% 50%; transform-origin: 8% 50%; }
    .reel-frame::after { background: linear-gradient(to bottom, transparent 45%, rgba(10, 14, 16, 0.75) 100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring::before { animation: none; }
  }

  @media (max-width: 640px) {
    .hero { min-height: 88vh; padding-top: 110px; }
    .scroll-cue { display: none; }
    .aurora span:nth-child(1) { left: 20%; }
  }
</style>
