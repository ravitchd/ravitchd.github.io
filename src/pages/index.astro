---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { Picture, getImage } from 'astro:assets';
import { SITE } from '../site';
import portrait from '../assets/dylan-portrait.jpg';
import fishing from '../assets/dylan-fishing.jpg';
import { experience, education } from '../data/resume';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf(),
);
const projects = allProjects.slice(0, 3);
const recipes = (await getCollection('recipes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const recipeCount = (await getCollection('recipes')).length;
const dishes = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const kitchen = dishes.slice(0, 4);

const year = (d: Date) => d.getUTCFullYear();
const short = (dates: string) => dates.replace(/[A-Za-z]+ (\d{4})/g, '$1').replace('Present', 'Now');

// Small hover previews for the editorial contents list
const peek = async (src: ImageMetadata) => (await getImage({ src, width: 480, format: 'webp' })).src;
const pizzaPeek = dishes[0] ? await peek(dishes[0].data.image) : undefined;
const menuPeek = dishes[1] ? await peek(dishes[1].data.image) : undefined;

const stories = [
  ...allProjects.filter((p) => p.data.featured).map((p) => ({
    href: `/projects/${p.id}/`,
    title: p.data.title,
    dek: p.data.summary,
    when: String(year(p.data.date)),
    peek: undefined as string | undefined,
  })),
  { href: '/prints/', title: 'Parts on the bench', dek: 'Live 3D models of things I have designed in CAD, from an M6 bolt to a capstone container.', when: 'CAD', peek: undefined },
  { href: '/recipes/', title: 'The menu', dek: `${recipeCount} recipes written up so far, and a long list still to write.`, when: 'Now', peek: menuPeek },
  { href: '/gallery/', title: 'The gallery', dek: 'A camera roll full of dinner, from Neapolitan pizza to taquitos.', when: 'Now', peek: pizzaPeek },
];

const firstName = SITE.name.split(' ')[0];
const lastName = SITE.name.split(' ').slice(1).join(' ');
const now = experience[0];
---

<Base>
  <!-- ======================= EDITORIAL ======================= -->
  <div class="ed only-ed">
    <div class="container">
      <div class="issue">
        <span>Profile</span>
        <span>{SITE.location}</span>
        <span>Vol. 1</span>
      </div>
      <h1 class="mast" aria-label={SITE.name}>
        <span class="mw" style="--i:0">{firstName}</span>
        <em class="mw" style="--i:1">{lastName}</em>
      </h1>

      <div class="spread">
        <div class="dekcol">
          <p class="eyebrow">{SITE.role}</p>
          <p class="dek">
            The engineer routing hazardous gas through chip fabs, and the pizza he makes when he gets home.
          </p>
          <dl class="facts">
            <div><dt>Now</dt><dd>{now.role}, {now.org}</dd></div>
            <div><dt>Studied</dt><dd>B.S. Mechanical Engineering, Washington State, 2025</dd></div>
            <div><dt>Based in</dt><dd>{SITE.location}</dd></div>
          </dl>
        </div>
        <figure class="cover">
          <Picture
            src={portrait}
            widths={[400, 640, 880]}
            sizes="(max-width: 860px) 100vw, 380px"
            formats={['avif', 'webp']}
            alt="Dylan in a dark suit and patterned tie, checking his watch"
            loading="eager"
          />
          <figcaption><b>Fig. 1</b> Dylan, on time.</figcaption>
        </figure>
        <div class="body">
          <p>
            Dylan designs fluid delivery systems for semiconductor fabrication facilities: high-pressure and hazardous gas
            routing, pipe classes picked for chemical compatibility, and the constructability reviews that keep it all buildable.
          </p>
          <p>
            Before that he grew silicon ingots in vacuum furnaces, drew sheet metal for Intel and LAM Research, and helped
            put a rocket into the top three of its category at Spaceport America Cup.
          </p>
          <div class="cta">
            <a class="btn primary" href="/resume/">Read the resume</a>
            <a class="more" href="/projects/">All projects →</a>
          </div>
        </div>
      </div>
    </div>

    <blockquote class="pull" data-reveal>
      <p>“I design <span class="rot" data-rotate={JSON.stringify(SITE.rotating)}>{SITE.rotating[0]}</span>”</p>
    </blockquote>

    <section class="container career" data-reveal>
      <div class="head"><h2>The career, <em>in brief</em></h2><a href="/resume/">Full resume →</a></div>
      <ol class="cols">
        {
          experience.map((job, i) => (
            <li>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <span class="when">{short(job.dates)}</span>
              <h3>{job.role}</h3>
              <p class="org">{job.org} · {job.location}</p>
              <p>{job.points[0]}</p>
            </li>
          ))
        }
        <li class="school">
          <span class="n">{String(experience.length + 1).padStart(2, '0')}</span>
          <span class="when">{short(education[0].dates)}</span>
          <h3>{education[0].degree.replace('B.S., ', 'B.S. ')}</h3>
          <p class="org">{education[0].school}</p>
          <p>Capstone sponsored by TSMC Washington. Rocketry with the WSUV Aerospace Club.</p>
        </li>
      </ol>
    </section>

    <section class="container toc-wrap">
      <div class="head" data-reveal><h2>In this issue</h2><span class="muted">{stories.length} stories</span></div>
      <ul class="toc">
        {
          stories.map((s, i) => (
            <li data-reveal>
              <a href={s.href} data-peek={s.peek}>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <span class="t">
                  <h3>{s.title}</h3>
                  <p>{s.dek}</p>
                </span>
                <span class="when">{s.when}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="peek" aria-hidden="true"><img alt="" /></div>
    </section>

    <section class="container feature">
      <figure data-reveal>
        <Picture
          src={fishing}
          widths={[420, 640, 840]}
          sizes="(max-width: 860px) 100vw, 420px"
          formats={['avif', 'webp']}
          alt="Dylan in a green rain jacket fishing from a beach while an aircraft carrier passes in the fog"
        />
        <figcaption><b>Fig. 2</b> Waiting on a bite while an aircraft carrier slides past in the fog.</figcaption>
      </figure>
      <div class="feature-copy" data-reveal style="--d:1">
        <p class="eyebrow">Off the clock</p>
        <h2>On the water, or in the <em>kitchen</em>.</h2>
        <p class="lead">When he isn't routing gas lines, Dylan is on the beach with a rod or at the counter with a pizza peel.</p>
        <p>
          {recipeCount} of his recipes are written up on this site so far, from bagels to lasagna, with dozens more on
          the list.
        </p>
        <div class="cta">
          <a class="btn" href="/recipes/">Open the menu</a>
          <a class="more" href="/gallery/">See the gallery →</a>
        </div>
      </div>
    </section>

    <section class="container kitchen">
      <div class="head" data-reveal><h2>From the kitchen</h2><a href="/gallery/">Gallery →</a></div>
      <div class="plates">
        {
          kitchen.map((d, i) => (
            <a href={d.data.recipe ? `/recipes/${d.data.recipe.id}/` : '/gallery/'} class="plate" data-reveal style={`--d:${i}`}>
              <Picture src={d.data.image} widths={[300, 480, 640]} sizes="(max-width: 760px) 50vw, 260px" formats={['avif', 'webp']} alt={d.data.alt} />
              <span class="cap">{d.data.title}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>

  <!-- ======================= SPEC SHEET ======================= -->
  <div class="spec only-spec">
    <section class="container sp-hero">
      <div class="frame" data-coords>
        <span class="tick t1" aria-hidden="true">A</span>
        <span class="tick t2" aria-hidden="true">B</span>
        <span class="tick t3" aria-hidden="true">1</span>
        <span class="tick t4" aria-hidden="true">2</span>
        <span class="readout" aria-hidden="true">X 000.0 · Y 000.0</span>
        <div class="sp-copy">
          <p class="eyebrow">{SITE.role} · {SITE.location}</p>
          <h1><span>{firstName}</span> <span class="ghost">{lastName}</span></h1>
          <p class="lede">
            I design <mark>hazardous gas and fluid delivery systems</mark> for semiconductor fabs. Off the clock I build
            rockets, model parts in CAD, and make a lot of pizza.
          </p>
          <div class="btns">
            <a class="btn primary" href="/resume/">View resume ↗</a>
            <a class="btn" href="/projects/">See projects →</a>
            <a class="btn" href={SITE.github}>GitHub</a>
          </div>
        </div>
        <figure class="fig">
          <div class="dim" aria-hidden="true"><span>Fig. 1 · Portrait</span></div>
          <div class="photo">
            <Picture
              src={portrait}
              widths={[400, 640, 880]}
              sizes="(max-width: 860px) 100vw, 400px"
              formats={['avif', 'webp']}
              alt="Dylan in a dark suit and patterned tie, checking his watch"
              loading="eager"
            />
            <span class="bub b1" aria-hidden="true">1</span>
            <span class="bub b2" aria-hidden="true">2</span>
            <span class="bub b3" aria-hidden="true">3</span>
          </div>
          <ol class="legend">
            <li><b>1</b> {now.org} · {now.role}</li>
            <li><b>2</b> WSU · B.S. ME, 2025</li>
            <li><b>3</b> 3rd in category, Spaceport America Cup</li>
          </ol>
        </figure>
      </div>
    </section>

    <section class="container sp-sec" data-reveal>
      <h2 class="sp-h"><b>01</b>Experience</h2>
      <table class="bom">
        <thead><tr><th>Item</th><th>Role</th><th>Organization</th><th class="m">Dates</th></tr></thead>
        <tbody>
          {
            experience.map((job, i) => (
              <tr>
                <td class="i">1.{i + 1}</td>
                <td class="r">{job.role}</td>
                <td>{job.org} · {job.location}</td>
                <td class="m">{short(job.dates)}</td>
              </tr>
            ))
          }
          <tr>
            <td class="i">1.{experience.length + 1}</td>
            <td class="r">{education[0].degree.replace('B.S., ', 'B.S. ')}</td>
            <td>{education[0].school}</td>
            <td class="m">{short(education[0].dates)}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="container sp-sec">
      <h2 class="sp-h" data-reveal><b>02</b>Parts list<a href="/projects/">All projects →</a></h2>
      <div class="grid">{projects.map((p, i) => <ProjectCard project={p} index={i} />)}</div>
    </section>

    <section class="container sp-sec">
      <h2 class="sp-h" data-reveal><b>03</b>Detail B: off the clock</h2>
      <div class="detail" data-reveal>
        <figure>
          <Picture
            src={fishing}
            widths={[400, 640, 800]}
            sizes="(max-width: 860px) 100vw, 400px"
            formats={['avif', 'webp']}
            alt="Dylan in a green rain jacket fishing from a beach while an aircraft carrier passes in the fog"
          />
          <figcaption>Detail B · Scale 1:1</figcaption>
        </figure>
        <div>
          <p class="note-h">Notes</p>
          <ol class="notes">
            <li>When I'm not routing gas lines, I'm on the water with a rod or in the kitchen with a pizza peel.</li>
            <li>{recipeCount} recipes written up so far, with dozens more on the list.</li>
            <li>Photos of what comes out of the oven live in the gallery.</li>
          </ol>
          <div class="btns"><a class="btn" href="/recipes/">Open the menu</a><a class="btn" href="/gallery/">Gallery</a></div>
        </div>
      </div>
    </section>

    <section class="container sp-sec">
      <h2 class="sp-h" data-reveal><b>04</b>From the kitchen<a href="/recipes/">All recipes →</a></h2>
      <div class="grid">{recipes.map((r, i) => <RecipeCard recipe={r} index={i} />)}</div>
    </section>
  </div>
</Base>

<script>
  import '../scripts/home';
</script>

<style>
  /* ---------------- Editorial ---------------- */
  .ed { padding-top: 6px; }
  .issue {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mast {
    font-size: clamp(4rem, 15.5vw, 13.5rem);
    line-height: 0.82;
    letter-spacing: -0.035em;
    margin: 30px 0 0;
    white-space: nowrap;
  }
  .mast em { color: var(--accent); }
  .mw { display: inline-block; }
  .mw + .mw { margin-left: 0.18em; }
  @media (prefers-reduced-motion: no-preference) {
    .js .mw { animation: rise 1s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(var(--i) * 120ms + 80ms); }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(0.25em); } }

  .spread {
    display: grid;
    grid-template-columns: 1fr 1fr 0.95fr;
    gap: 40px;
    padding: 40px 0 64px;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .dek { font-family: var(--display); font-size: clamp(1.7rem, 2.6vw, 2.1rem); line-height: 1.12; margin: 0 0 24px; }
  .facts { margin: 0; border-top: 1px solid var(--border); }
  .facts div { display: grid; grid-template-columns: 5.5rem 1fr; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
  .facts dt { font-weight: 600; }
  .facts dd { margin: 0; color: var(--muted); }
  .cover { margin: 0; }
  .cover :global(img) { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  figcaption { font-size: 0.8rem; color: var(--muted); margin-top: 10px; }
  figcaption b { color: var(--text); font-weight: 600; margin-right: 6px; }
  .body p { line-height: 1.7; font-size: 1.02rem; }
  .body p:first-child::first-letter {
    float: left;
    font-family: var(--display);
    font-size: 5.1rem;
    line-height: 0.76;
    padding: 8px 10px 0 0;
    color: var(--accent);
  }
  .cta { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; margin-top: 24px; }
  .more { color: var(--text); font-weight: 600; text-decoration: none; border-bottom: 1.5px solid var(--rule); padding-bottom: 2px; }
  .more:hover { color: var(--accent); border-color: var(--accent); }

  .pull { margin: 0; padding: 88px 24px; text-align: center; }
  .pull p {
    font-family: var(--display);
    font-style: italic;
    font-size: clamp(2rem, 4.6vw, 3.8rem);
    line-height: 1.08;
    max-width: 960px;
    margin: 0 auto;
  }
  .rot { color: var(--accent); display: inline-block; transition: opacity 0.35s ease, transform 0.35s ease; }
  .rot:global(.out) { opacity: 0; transform: translateY(-0.2em); }
  .rot:global(.in) { opacity: 0; transform: translateY(0.2em); transition: none; }

  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; border-bottom: 1px solid var(--rule); padding-bottom: 12px; margin-bottom: 4px; }
  .head h2 { margin: 0; }
  .head a { color: var(--text); text-decoration: none; font-weight: 500; font-size: 0.92rem; }
  .head a:hover { color: var(--accent); }

  .career { padding-bottom: 88px; }
  .cols { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .cols li { padding: 22px 22px 10px; border-left: 1px solid var(--border); }
  .cols li:first-child { border-left: 0; padding-left: 0; }
  .cols .n { font-family: var(--display); font-size: 2.6rem; line-height: 1; color: var(--accent); display: block; }
  .cols .when { display: block; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 12px 0 6px; }
  .cols h3 { margin: 0 0 4px; font-size: 1.5rem; line-height: 1.05; }
  .cols .org { font-size: 0.88rem; font-weight: 500; margin-bottom: 8px; }
  .cols p { font-size: 0.9rem; color: var(--muted); line-height: 1.55; margin: 0 0 8px; }

  .toc-wrap { padding-bottom: 88px; position: relative; }
  .toc { list-style: none; margin: 0; padding: 0; }
  .toc a {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: baseline;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: padding 0.3s cubic-bezier(.2,.8,.2,1), color 0.2s ease;
  }
  .toc a:hover { padding-left: 14px; color: var(--accent); }
  .toc .n { font-family: var(--display); font-size: 1.3rem; color: var(--muted); }
  .toc h3 { font-size: clamp(1.8rem, 3.8vw, 3rem); line-height: 1; margin: 0; }
  .toc p { margin: 8px 0 0; color: var(--muted); font-size: 0.95rem; max-width: 42rem; }
  .toc .when { font-size: 0.8rem; color: var(--muted); font-weight: 500; }
  .peek {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 30;
    width: 220px;
    aspect-ratio: 4 / 5;
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    translate: -50% -55%;
    transition: opacity 0.2s ease, scale 0.25s cubic-bezier(.2,.8,.2,1);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.22);
  }
  .peek:global(.on) { opacity: 1; scale: 1; }
  .peek img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .feature { display: grid; grid-template-columns: 420px 1fr; gap: 64px; align-items: center; padding-bottom: 88px; }
  .feature figure { margin: 0; }
  .feature :global(img) { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .feature h2 { font-size: clamp(2.4rem, 4.6vw, 3.8rem); line-height: 1; }
  .lead { font-family: var(--display); font-size: 1.6rem; line-height: 1.2; }
  .feature-copy > p:not(.lead):not(.eyebrow) { color: var(--muted); max-width: 34rem; }

  .kitchen { padding-bottom: 24px; }
  .plates { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 22px; }
  .plate { color: inherit; text-decoration: none; }
  .plate :global(img) { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; transition: filter 0.3s ease; }
  .plate:hover :global(img) { filter: brightness(1.06) saturate(1.08); }
  .plate .cap { display: block; font-family: var(--display); font-size: 1.2rem; line-height: 1.15; margin-top: 10px; }
  .plate:hover .cap { color: var(--accent); }

  @media (max-width: 960px) {
    .spread { grid-template-columns: 1fr 1fr; }
    .body { grid-column: 1 / -1; }
    .cols { grid-template-columns: 1fr 1fr; }
    .cols li:nth-child(3) { border-left: 0; padding-left: 0; }
    .feature { grid-template-columns: 1fr 1fr; gap: 40px; }
  }
  @media (max-width: 680px) {
    .issue span:nth-child(2) { display: none; }
    .mast { white-space: normal; margin-top: 20px; }
    .spread { grid-template-columns: 1fr; gap: 28px; padding-top: 28px; }
    .cols { grid-template-columns: 1fr; }
    .cols li { border-left: 0; padding-left: 0; border-bottom: 1px solid var(--border); }
    .toc a { grid-template-columns: 34px 1fr; gap: 12px; }
    .toc .when { display: none; }
    .feature { grid-template-columns: 1fr; }
    .plates { grid-template-columns: 1fr 1fr; gap: 12px; }
    .pull { padding: 64px 16px; }
  }

  /* ---------------- Spec Sheet ---------------- */
  .sp-hero { padding-top: 36px; padding-bottom: 24px; }
  .frame {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 56px;
    padding: 56px 48px 44px;
    border: 1px solid var(--rule);
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: -1px -1px;
    background-color: var(--bg);
  }
  .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 88%, transparent) 55%, color-mix(in srgb, var(--bg) 70%, transparent));
    pointer-events: none;
  }
  .frame > .sp-copy, .frame > .fig { position: relative; }
  .tick { position: absolute; font: 500 10px var(--mono); color: var(--muted); background: var(--bg); padding: 0 4px; line-height: 1; z-index: 1; }
  .t1 { left: -8px; top: 30%; } .t2 { left: -8px; top: 75%; }
  .t3 { top: -6px; left: 30%; } .t4 { top: -6px; left: 75%; }
  .readout {
    position: absolute;
    right: 12px;
    top: 10px;
    font: 500 11px var(--mono);
    color: var(--muted);
    letter-spacing: 0.04em;
    z-index: 1;
  }
  .sp-copy { align-self: center; }
  .spec h1 { margin: 18px 0 24px; font-size: clamp(3rem, 7.4vw, 6.2rem); line-height: 0.92; }
  .spec h1 span { display: block; }
  .ghost { color: color-mix(in srgb, var(--text) 32%, var(--bg)); }
  .lede { font-size: 1.18rem; line-height: 1.5; max-width: 32rem; margin: 0 0 28px; }
  mark { background: linear-gradient(transparent 62%, color-mix(in srgb, var(--accent) 30%, transparent) 62%); color: inherit; }
  .btns { display: flex; gap: 10px; flex-wrap: wrap; }
  .fig { margin: 0; }
  .dim {
    position: relative;
    border-top: 1px solid var(--muted);
    margin: 0 0 14px;
    text-align: center;
    font: 500 10.5px var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .dim::before, .dim::after { content: ''; position: absolute; top: -5px; height: 9px; border-left: 1px solid var(--muted); }
  .dim::before { left: 0; } .dim::after { right: 0; }
  .dim span { position: relative; top: -8px; background: var(--bg); padding: 0 8px; }
  .photo { position: relative; border: 1px solid var(--rule); }
  .photo :global(img) { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
