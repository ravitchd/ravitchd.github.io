---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PrintStage from '../../components/PrintStage.astro';

// Each print is a Markdown file in src/content/prints (see _template.md there).
const prints = (await getCollection('prints')).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="3D Prints" description="Parts Dylan has designed and 3D printed, with the files to print your own.">
  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>3D prints</p>
      <h1 data-reveal style="--d:1">Designed, sliced, printed</h1>
      <p class="lead muted" data-reveal style="--d:2">
        Parts I've modeled in CAD and printed, each with a live model you can spin and the files to print your own.
      </p>

      <div class="list">
        {
          prints.map((p, i) => {
            const d = p.data;
            const specs = [
              d.material && ['Material', d.material],
              d.layerHeight && ['Layer', `${d.layerHeight} mm`],
              d.printTime && ['Print time', d.printTime],
            ].filter(Boolean) as [string, string][];
            return (
              <a class="card print" href={`/prints/${p.id}/`} data-reveal style={`--d:${i + 3}`}>
                <PrintStage model={d.model} title={d.title} layerHeight={d.layerHeight} />
                <div class="body">
                  {d.example && <span class="flag">Example entry</span>}
                  <h2 style={`view-transition-name: pr-${p.id}`}>{d.title}</h2>
                  <p>{d.summary}</p>
                  {specs.length > 0 && (
                    <dl>
                      {specs.map(([k, v]) => (
                        <div>
                          <dt>{k}</dt>
                          <dd>{v}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
                </div>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>

<script>
  import { initPrints } from '../../scripts/prints/main';
  initPrints();
</script>

<style>
  .lead { max-width: 560px; font-size: 1.08rem; }
  .list { display: grid; gap: 24px; margin-top: 36px; }
  .print {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 28px;
    align-items: center;
    padding: 16px;
  }
  .body { display: flex; flex-direction: column; gap: 0.7rem; padding: 8px 12px 8px 0; }
  .print h2 { margin: 0; font-size: clamp(1.4rem, 2.6vw, 1.8rem); }
  .flag {
    align-self: flex-start;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    border: 1px dashed color-mix(in srgb, var(--accent) 60%, var(--border));
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 6px 26px;
    margin: 0.2rem 0 0;
  }
  dt { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  dd { margin: 0; font-weight: 600; font-size: 0.95rem; }
  @media (max-width: 760px) {
    .print { grid-template-columns: 1fr; gap: 16px; padding: 12px; }
    .body { padding: 4px 8px 10px; }
  }
</style>
