---
import type { CollectionEntry } from 'astro:content';
import { summary, CATEGORY_LABEL } from '../data/recipes';
interface Props { recipe: CollectionEntry<'recipes'>; index?: number }
const { recipe, index = 0 } = Astro.props;
const { title, description, tags, category } = recipe.data;
const line = summary(recipe);
---

<a
  class="card recipe"
  href={`/recipes/${recipe.id}/`}
  data-reveal
  style={`--d:${index % 6}`}
  data-search={`${title} ${description ?? ''} ${tags.join(' ')} ${category}`.toLowerCase()}
  data-category={category}
>
  <span class="initial" aria-hidden="true">{title[0]}</span>
  <span class="kind">{CATEGORY_LABEL[category]}</span>
  <h3 style={`view-transition-name: r-${recipe.id}`}>{title}</h3>
  {description && <p>{description}</p>}
  {line && <small class="muted">{line}</small>}
  {tags.length > 0 && <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
  <span class="arrow" aria-hidden="true">↗</span>
</a>

<style>
  .recipe { overflow: hidden; min-height: 170px; }
  .initial {
    position: absolute;
    right: -0.06em;
    bottom: -0.32em;
    font-family: var(--serif);
    font-size: 9rem;
    line-height: 1;
    font-weight: 600;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--accent) 28%, transparent);
    pointer-events: none;
    transition: transform 0.6s cubic-bezier(.2,.8,.2,1), -webkit-text-stroke-color 0.3s ease;
  }
  a.recipe:hover .initial {
    transform: translate(-8px, -6px) rotate(-6deg);
    -webkit-text-stroke-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .kind { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  h3, p, small, .tags { position: relative; }
  @media (prefers-reduced-motion: reduce) { .initial { transition: none; } }
</style>
