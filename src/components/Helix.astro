---
// Scroll-driven double helix: panels ride one strand of a rotating DNA helix
// and turn to face the viewer as you scroll. Without JS, or with reduced
// motion, the panels render as a plain stacked timeline.
import { getCollection } from 'astro:content';
import { experience, education } from '../data/resume';

const projects = (await getCollection('projects'))
  .filter((p) => p.id !== 'personal-website')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const panels = [
  ...experience.map((e) => ({
    kind: 'Experience',
    title: e.role,
    meta: `${e.org} · ${e.dates}`,
    text: e.points[0],
    href: '/resume/',
  })),
  ...education.slice(0, 1).map((e) => ({
    kind: 'Education',
    title: e.degree,
    meta: `${e.school} · ${e.dates}`,
    text: e.detail ?? '',
    href: '/resume/',
  })),
  ...projects.map((p) => ({
    kind: 'Project',
    title: p.data.title,
    meta: p.data.tech.join(' · '),
    text: p.data.summary,
    href: `/projects/${p.id}/`,
  })),
];

---

<section class="helix" id="story" data-helix style={`--n:${panels.length}`} aria-labelledby="helix-title">
  <div class="helix-stage">
    <div class="helix-head container">
      <p class="eyebrow">The story so far</p>
      <h2 id="helix-title">Experience, school and builds</h2>
      <p class="muted hint" aria-hidden="true">Keep scrolling to spin through it</p>
    </div>

    <canvas class="helix-canvas" aria-hidden="true"></canvas>

    <ol class="helix-panels">
      {
        panels.map((p, i) => (
          <li class="panel" data-panel={i}>
            <a href={p.href} class="panel-inner">
              <span class="kind">
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                {p.kind}
              </span>
              <h3>{p.title}</h3>
              <p class="meta">{p.meta}</p>
              {p.text && <p class="text">{p.text}</p>}
            </a>
          </li>
        ))
      }
    </ol>

    <div class="helix-count" aria-hidden="true">
      <span data-count>01</span> / {String(panels.length).padStart(2, '0')}
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-helix]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const canvas = root?.querySelector<HTMLCanvasElement>('.helix-canvas');
  const ctx = canvas?.getContext('2d');

  if (root && canvas && ctx && !reduce.matches) {
    root.classList.add('live');
    const stage = root.querySelector<HTMLElement>('.helix-stage')!;
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const N = panels.length;

    // Panels ride strand A. Each panel is one unit of progress: it climbs one
    // pitch and turns STEP degrees, so the panels sit exactly on the helix.
    const STEP = 160;
    const RUNG = 30; // degrees between base pairs
    const FOCAL = 1100;
    let w = 0, h = 0, cx = 0, cy = 0, R = 0, pitch = 0, twist = 0;
    let accent = '#2f5d50', gold = '#d9a441';

    const colors = () => {
      const cs = getComputedStyle(document.documentElement);
      accent = cs.getPropertyValue('--accent').trim() || accent;
    };

    const measure = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = stage.clientWidth;
      h = stage.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = w / 2;
      cy = h * 0.58;
      R = Math.min(320, Math.max(90, w * 0.22));
      pitch = Math.max(300, h * 0.45);
      twist = STEP / pitch;
    };

    // Project a point on the helix (angle in degrees, height in px) to screen.
    const project = (deg: number, y: number) => {
      const rad = (deg * Math.PI) / 180;
      const z = R * Math.cos(rad);
      const s = FOCAL / (FOCAL - z);
      return { x: cx + R * Math.sin(rad) * s, y: cy + y * s, s, depth: Math.cos(rad) };
    };

    let target = 0, current = 0, raf = 0;

    const progress = () => {
      const r = root.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 0;
      return p * (N - 1);
    };

    const drawHelix = () => {
      ctx.clearRect(0, 0, w, h);
      const top = -cy - 80, bottom = h - cy + 80;
      const shift = current * pitch; // strand features travel with the panels

      // Base pairs: they slide along the helix with the panels, which reads as the helix spinning.
      const gap = RUNG / twist;
      const first = Math.floor((top + shift) / gap);
      for (let k = first; k * gap - shift < bottom; k++) {
        const y = k * gap - shift;
        const deg = y * twist;
        const A = project(deg, y);
        const B = project(deg + 180, y);
        const g = ctx.createLinearGradient(A.x, A.y, B.x, B.y);
        g.addColorStop(0, accent);
        g.addColorStop(1, gold);
        ctx.globalAlpha = 0.28;
        ctx.strokeStyle = g;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(A.x, A.y);
        ctx.lineTo(B.x, B.y);
        ctx.stroke();
        for (const [P, c] of [[A, accent], [B, gold]] as const) {
          ctx.globalAlpha = 0.35 + 0.6 * ((P.depth + 1) / 2);
          ctx.fillStyle = c;
          ctx.beginPath();
          ctx.arc(P.x, P.y, 2.5 + 3.5 * ((P.depth + 1) / 2), 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // Backbones: two continuous strands, thicker and brighter in front.
      for (const [off, c] of [[0, accent], [180, gold]] as const) {
        ctx.strokeStyle = c;
        let prev = project(top * twist + off, top);
        for (let y = top + 8; y <= bottom; y += 8) {
          const P = project(y * twist + off, y);
          const d = (P.depth + 1) / 2;
          ctx.globalAlpha = 0.15 + 0.55 * d;
          ctx.lineWidth = 1 + 3 * d;
          ctx.beginPath();
          ctx.moveTo(prev.x, prev.y);
          ctx.lineTo(P.x, P.y);
          ctx.stroke();
          prev = P;
        }
      }
      ctx.globalAlpha = 1;
    };

    const render = () => {
      current += (target - current) * 0.12;
      if (Math.abs(target - current) < 0.0005) current = target;

      drawHelix();
      for (let i = 0; i < N; i++) {
        const t = i - current;
        const deg = t * STEP;
        const P = project(deg, t * pitch);
        const facing = Math.max(0, P.depth);
        const el = panels[i];
        el.style.transform = `translate3d(${P.x}px, ${P.y}px, 0) translate(-50%, -50%) scale(${P.s}) perspective(1000px) rotateY(${Math.sin((deg * Math.PI) / 180) * 38}deg)`;
        el.style.opacity = String(Math.max(0, 1 - Math.abs(t) * 0.45) * (0.18 + 0.82 * facing));
        el.style.zIndex = String(100 + Math.round(P.depth * 50));
        const focused = Math.abs(t) < 0.5;
        el.style.pointerEvents = focused ? 'auto' : 'none';
        el.classList.toggle('focus', focused);
      }
      count.textContent = String(Math.min(N, Math.round(current) + 1)).padStart(2, '0');
      raf = current !== target ? requestAnimationFrame(render) : 0;
    };

    const kick = () => {
      target = progress();
      if (!raf) raf = requestAnimationFrame(render);
    };

    colors();
    measure();
    target = current = progress();
    render();
    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      render();
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      colors();
      render();
    });
  }
</script>

<style>
  .helix { position: relative; padding: 40px 0; }
  .helix-head { position: relative; z-index: 2; }
  .helix-head h2 { margin-bottom: 0.3em; }
  .hint { display: none; font-size: 0.9rem; }

  /* Fallback: a simple vertical timeline */
  .helix-count { display: none; }
  .helix-panels {
    list-style: none;
    margin: 28px auto 0;
    padding: 0 24px;
    max-width: var(--max);
    display: grid;
    gap: 16px;
  }
  .panel-inner {
    display: block;
    padding: 24px 26px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
  }
  .kind {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .idx {
    font-family: var(--serif);
    font-size: 0.95rem;
    letter-spacing: 0;
    color: var(--muted);
  }
  .panel h3 { margin: 0 0 4px; font-size: 1.3rem; }
  .meta { margin: 0 0 10px; color: var(--muted); font-size: 0.88rem; }
  .text { margin: 0; font-size: 0.95rem; line-height: 1.55; }

  /* Live helix */
  .helix.live { height: calc(var(--n) * 62vh + 100vh); padding: 0; }
  .helix.live .helix-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .helix.live .hint { display: block; }
  .helix-canvas { display: none; }
  .helix.live .helix-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .helix.live .helix-panels { position: absolute; inset: 0; margin: 0; padding: 0; max-width: none; z-index: 1; }

  .helix.live .panel {
    position: absolute;
    left: 0;
    top: 0;
    width: min(440px, 78vw);
    will-change: transform, opacity;
    backface-visibility: hidden;
  }
  .helix.live .panel-inner {
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.35);
    background: var(--surface);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .helix.live .panel.focus .panel-inner {
    border-color: color-mix(in srgb, var(--accent) 60%, var(--border));
    box-shadow: 0 40px 80px -30px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .helix.live .helix-count {
    display: block;
    position: absolute;
    right: max(24px, calc((100vw - var(--max)) / 2 + 24px));
    bottom: 32px;
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--muted);
  }
  .helix-count span { color: var(--text); font-size: 1.6rem; }

  .helix.live .helix-head {
    z-index: 2;
    pointer-events: none;
    max-width: none;
    padding-top: 88px;
    padding-bottom: 40px;
    background: linear-gradient(var(--bg) 72%, transparent);
  }
  .helix.live .helix-head > * { max-width: calc(var(--max) - 48px); margin-left: auto; margin-right: auto; }
  .helix.live .helix-head a { pointer-events: auto; }
  @media (max-width: 640px) {
    .helix.live .helix-head { padding-top: 76px; }
    .text { font-size: 0.9rem; }
  }
</style>
