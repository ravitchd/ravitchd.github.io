---
import { SITE } from '../site';

const links = [
  { href: '/resume/', label: 'Resume' },
  { href: '/projects/', label: 'Projects' },
  { href: '/prints/', label: '3D Design' },
  { href: '/aerospace/', label: 'Aerospace' },
  { href: '/recipes/', label: 'Recipes' },
  { href: '/gallery/', label: 'Gallery' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={SITE.name}><span class="full">{SITE.name}</span><span class="short" aria-hidden="true">{SITE.name.split(' ').map((w) => w[0]).join('')}</span></a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
      <span class="sr-only">Menu</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // Phones: the nav folds into a menu button.
  const header = document.querySelector<HTMLElement>('.site-header');
  const button = header?.querySelector<HTMLButtonElement>('[data-menu]');
  if (header && button) {
    const set = (open: boolean) => {
      header.classList.toggle('open', open);
      button.setAttribute('aria-expanded', String(open));
    };
    button.addEventListener('click', () => set(!header.classList.contains('open')));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) set(false);
    });
    window.addEventListener('scroll', () => header.classList.contains('open') && window.scrollY > 40 && set(false), { passive: true });
  }
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: transform 0.35s cubic-bezier(.2,.8,.2,1), border-color 0.3s ease, background 0.3s ease;
  }
  header:not(.scrolled) { background: transparent; backdrop-filter: none; }
  header.scrolled { border-bottom-color: var(--border); }
  header.tucked { transform: translateY(-100%); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }
  .brand {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .short { display: none; }
  nav { display: flex; gap: 4px; }
  nav a {
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }
  nav a { position: relative; transition: color 0.2s ease; }
  nav a::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.28rem;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(.2,.8,.2,1);
  }
  nav a:hover { color: var(--text); }
  nav a:hover::after { transform: scaleX(1); transform-origin: left; }
  nav a[aria-current='page']::after { display: none; }
  nav a[aria-current='page'] { color: var(--accent); background: var(--accent-soft); }
  .menu { display: none; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  nav a { white-space: nowrap; }
  @media (max-width: 760px) {
    nav a { padding: 0.4rem 0.6rem; font-size: 0.92rem; }
    nav a::after { left: 0.6rem; right: 0.6rem; }
  }
  @media (max-width: 700px) {
    .menu {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      margin-right: -6px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--text);
      cursor: pointer;
    }
    .menu:hover { background: var(--accent-soft); }
    .bars, .bars::before, .bars::after {
      display: block;
      width: 18px;
      height: 1.6px;
      border-radius: 2px;
      background: currentColor;
      transition: transform 0.3s cubic-bezier(.2,.8,.2,1), opacity 0.2s ease;
    }
    .bars { position: relative; }
    .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
    .bars::before { transform: translateY(-6px); }
    .bars::after { transform: translateY(6px); }
    header.open .bars { background: transparent; }
    header.open .bars::before { transform: rotate(45deg); background: var(--text); }
    header.open .bars::after { transform: rotate(-45deg); background: var(--text); }

    nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 2px;
      padding: 8px 16px 16px;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 18px 30px -24px rgb(0 0 0 / 0.35);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.22s ease, transform 0.3s cubic-bezier(.2,.8,.2,1), visibility 0s linear 0.3s;
    }
    header.open nav {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity 0.22s ease, transform 0.3s cubic-bezier(.2,.8,.2,1), visibility 0s;
    }
    header.open { background: var(--bg); backdrop-filter: none; }
    nav a { padding: 0.75rem 0.9rem; font-size: 1.05rem; border-radius: 12px; }
    nav a::after { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    nav, .bars, .bars::before, .bars::after { transition: none !important; }
  }
</style>
