---
import { SITE } from '../site';

const links = [
  { href: '/resume/', label: 'Resume' },
  { href: '/projects/', label: 'Projects' },
  { href: '/prints/', label: 'CAD' },
  { href: '/recipes/', label: 'Recipes' },
  { href: '/gallery/', label: 'Gallery' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={SITE.name}><span class="full">{SITE.name}</span><span class="short" aria-hidden="true">{SITE.name.split(' ').map((w) => w[0]).join('')}</span></a>
    <nav aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: transform 0.35s cubic-bezier(.2,.8,.2,1), border-color 0.3s ease, background 0.3s ease;
  }
  header:not(.scrolled) { background: transparent; backdrop-filter: none; }
  header.scrolled { border-bottom-color: var(--border); }
  header.tucked { transform: translateY(-100%); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }
  .brand {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .short { display: none; }
  nav { display: flex; gap: 4px; }
  nav a {
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }
  nav a { position: relative; transition: color 0.2s ease; }
  nav a::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.28rem;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(.2,.8,.2,1);
  }
  nav a:hover { color: var(--text); }
  nav a:hover::after { transform: scaleX(1); transform-origin: left; }
  nav a[aria-current='page']::after { display: none; }
  nav a[aria-current='page'] { color: var(--accent); background: var(--accent-soft); }
  @media (max-width: 480px) {
    .brand { font-size: 1.1rem; }
    .full { display: none; }
    .short { display: inline; }
    nav { gap: 0; }
    nav a { padding: 0.35rem 0.45rem; font-size: 0.86rem; }
    nav a::after { left: 0.45rem; right: 0.45rem; }
  }
  @media (max-width: 400px) {
    .bar { gap: 8px; }
    nav a { padding: 0.3rem 0.3rem; font-size: 0.78rem; }
    nav a::after { left: 0.3rem; right: 0.3rem; }
  }
</style>
