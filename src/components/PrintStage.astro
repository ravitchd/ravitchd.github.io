---
// The 3D viewer for one print. `controls` adds the slicer-style layer scrubber.
interface Props {
  model: string;
  title: string;
  layerHeight?: number;
  controls?: boolean;
}
const { model, title, layerHeight = 0.2, controls = false } = Astro.props;
---

<div class:list={['stage', { big: controls }]} data-print-stage>
  <canvas
    data-print={model}
    data-layer-height={layerHeight}
    data-interactive={controls ? '' : undefined}
    data-cursor={controls ? '' : undefined}
    role="img"
    aria-label={`3D model of ${title}`}></canvas>
  <div class="loading" aria-hidden="true"><span></span></div>
  <p class="fallback">3D preview isn't available in this browser.</p>
  {
    controls && (
      <div class="tools">
        <label class="scrub">
          <span class="lbl">Layer</span>
          <input type="range" min="0" max="1" step="0.001" value="1" data-layer aria-label="Show the model up to this layer" />
          <output data-layer-readout>–</output>
        </label>
        <button type="button" class="tool" data-replay>
          Replay print
        </button>
        <button type="button" class="tool" data-wire aria-pressed="false">
          Wireframe
        </button>
      </div>
    )
  }
  {controls && <p class="hint" aria-hidden="true">Drag to orbit · scroll to zoom</p>}
</div>

<style>
  .stage {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 50% 15%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 60%),
      linear-gradient(180deg, color-mix(in srgb, var(--surface) 70%, var(--bg)), var(--bg));
    border: 1px solid var(--border);
  }
  .stage.big { aspect-ratio: 16 / 10; }
  /* On phones the tools sit under the model instead of over it. */
  @media (max-width: 640px) {
    .stage.big { aspect-ratio: auto; }
    .stage.big canvas { position: relative; inset: auto; aspect-ratio: 1 / 1; height: auto; }
    .stage.big .tools { position: relative; left: 0; right: 0; bottom: 0; padding: 0 12px 12px; }
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.6s ease;
    touch-action: pan-y;
  }
  canvas[data-interactive] { cursor: grab; touch-action: none; }
  canvas[data-interactive]:active { cursor: grabbing; }
  .stage.ready canvas { opacity: 1; }

  .loading {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 38%;
    max-width: 180px;
    height: 3px;
    transform: translate(-50%, -50%);
    border-radius: 3px;
    background: var(--border);
    overflow: hidden;
  }
  .loading span {
    position: absolute;
    inset: 0;
    width: 40%;
    background: var(--accent);
    animation: load 1.1s ease-in-out infinite;
  }
  @keyframes load {
    from { transform: translateX(-100%); }
    to { transform: translateX(250%); }
  }
  .stage.ready .loading, .stage.failed .loading { display: none; }

  .fallback {
    display: none;
    position: absolute;
    inset: 0;
    margin: 0;
    place-items: center;
    padding: 24px;
    text-align: center;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .stage.failed .fallback { display: grid; }

  .tools {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease 0.2s, transform 0.5s cubic-bezier(.2,.8,.2,1) 0.2s;
  }
  .stage.ready .tools { opacity: 1; transform: none; }
  .scrub, .tool {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(10px);
    color: var(--text);
    font: 500 0.85rem var(--sans);
  }
  .scrub { flex: 1 1 260px; min-width: 0; }
  .lbl { color: var(--muted); }
  output {
    min-width: 5.5ch;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    font-weight: 600;
  }
  input[type='range'] { flex: 1; min-width: 0; accent-color: var(--accent); }
  .tool { cursor: pointer; transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease; }
  .tool:hover { border-color: var(--accent); }
  .tool[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .hint {
    position: absolute;
    top: 12px;
    right: 14px;
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
    pointer-events: none;
  }
  @media (hover: none) {
    .hint { display: none; }
  }
</style>
